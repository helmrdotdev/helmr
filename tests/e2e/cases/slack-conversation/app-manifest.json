{
  "display_information": {
    "name": "Helmr Dev",
    "description": "Synthetic conversation verification",
    "background_color": "#24304A"
  },
  "features": {
    "bot_user": {
      "display_name": "Helmr Dev",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "DMs create shared Helmr Sessions. Organization members can read them; owners, admins and developers can continue or control work, and viewers can answer questions. New message: new Session. Thread reply: continue."
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://helmr-verification.invalid/auth/slack/callback",
      "https://helmr-verification.invalid/api/slack/user-links/callback"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "chat:write",
        "assistant:write",
        "im:history",
        "im:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true,
    "event_subscriptions": {
      "request_url": "https://helmr-verification.invalid/integrations/slack/apps/REGISTRATION_ID/events",
      "bot_events": [
        "app_mention",
        "agent_session_stopped",
        "message.channels",
        "message.groups",
        "app_uninstalled",
        "tokens_revoked",
        "message.im",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://helmr-verification.invalid/integrations/slack/apps/REGISTRATION_ID/interactions"
    }
  }
}
