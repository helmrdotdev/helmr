{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "bun-types"
    ]
  },
  "include": [
    "cases/**/*.ts",
    "support/**/*.ts",
    "helmr.config.ts"
  ]
}
