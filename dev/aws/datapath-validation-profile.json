{
  "schema": "helmrdotdev.aws-datapath-validation-profile.v0",
  "topology": {
    "allow_extended_worker_capacity": true,
    "build_worker_max": 1,
    "isolated_stack": true,
    "nat_gateway_max": 1,
    "ready_run_workers": 2,
    "run_worker_execution_slots": 2,
    "run_worker_max": 2
  },
  "evidence": {
    "artifact_kinds": [
      "packet",
      "rules",
      "binding",
      "topology",
      "cleanup"
    ],
    "max_case_bytes": 262144,
    "max_trace_events": 256,
    "remote_retrieval": "chunked-byte-count-sha256"
  },
  "cases": [
    {
      "id": "hook-discovery",
      "category": "datapath",
      "task": null,
      "repetitions": 1,
      "timeout_seconds": 3600,
      "producer": {
        "path": "dev/aws/validation-cases/datapath-validation.sh",
        "checks": [
          "tap-path-observed",
          "cni-peer-path-observed",
          "legacy-hook-correlation-measured",
          "cleanup-proven"
        ]
      }
    }
  ]
}
