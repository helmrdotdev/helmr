{
  "name": "helmr-starter-opencode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun build tests/*.test.ts --target=node --tsconfig-override tests/tsconfig.json --external \"@opencode/*\" --external effect --outdir dist --entry-naming \"[name].mjs\" && node --test dist/*.test.mjs"
  },
  "dependencies": {
    "@helmr/sdk": "file:../../dist/npm/sdk/package",
    "@opencode/sdk": "2.2.2",
    "@opencode/core": "2.2.2",
    "@opencode/schema": "2.2.2",
    "effect": "4.0.6",
    "@opencode/util": "2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@helmr/proto": "file:../../dist/npm/proto/package"
  }
}
