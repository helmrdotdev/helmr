aws_region = "ap-northeast-1"
name       = "helmr-quickstart"
region_id  = "ap-northeast-1"

# Ubuntu 24.04 LTS amd64 AMI with cloud-init and SSM Agent in this Region.
control_ami_id = "ami-replace-with-regional-ubuntu-ami"
app_origin    = "https://helmr.example.com"

# Released Product image; use a Worker AMI built from the same release bundles.
helmr_version      = "v0.2.2"
controlplane_image = "ghcr.io/helmrdotdev/control-plane@sha256:a6f1121a6665a18a8be0fe1d7f15f0a3ccb01461d51045f9060136f981ce55d9"
worker_ami_id      = "ami-replace-with-release-worker-ami"

# Existing immutable Platform Artifact store with the signed Runtime published.
platform_store_uri         = "s3://replace-with-platform-store/objects"
platform_store_bucket_arn  = "arn:aws:s3:::replace-with-platform-store"
platform_store_kms_key_arn = "arn:aws:kms:ap-northeast-1:123456789012:key/replace-me"

github_oauth_client_id = "replace-with-github-oauth-client-id"

# Start the control services and complete setup before enabling the Worker.
create_worker = false
worker_count  = 1

# One small execution slot on a separate c8i.large; no automatic scaling.
worker_host_type           = "c8i.large"
worker_root_volume_size_gb = 320
worker_execution_slots    = 1
worker_vm_vcpus            = 1
worker_vm_memory_mib       = 2048

slack_transport = "socket"
controlplane_environment = {
  # Set verified operator emails before their first login when needed.
}
