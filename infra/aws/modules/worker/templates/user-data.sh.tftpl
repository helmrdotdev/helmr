#!/bin/sh
set -eu
umask 077
date +%s >/run/helmr-launch-started-at

install -d -m 0750 -o root -g root /etc/helmr
cat >/etc/helmr/guest-resolv.conf <<'EOF'
%{ for nameserver in guest_nameservers ~}
nameserver ${nameserver}
%{ endfor ~}
EOF
chown root:root /etc/helmr/guest-resolv.conf
chmod 0644 /etc/helmr/guest-resolv.conf

metadata_url=http://169.254.169.254/latest
metadata_token() {
  curl -fsS -X PUT "$metadata_url/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600"
}
metadata_get() {
  path="$1"
  token="$(metadata_token)"
  curl -fsS -H "X-aws-ec2-metadata-token: $token" "$metadata_url/$path"
}
aws_region='${aws_region}'
export AWS_REGION="$aws_region"
export AWS_DEFAULT_REGION="$aws_region"

env_tmp="$(mktemp /etc/helmr/worker.env.XXXXXX)"
cat >"$env_tmp" <<'EOF'
%{ for key, value in environment ~}
${key}=${value}
%{ endfor ~}
EOF

checkpoint_key="$(aws secretsmanager get-secret-value --secret-id '${checkpoint_key_secret_arn}' --query SecretString --output text)"

{
  printf 'AWS_REGION=%s\n' "$aws_region"
  printf 'AWS_DEFAULT_REGION=%s\n' "$aws_region"
  printf 'CHECKPOINT_ENCRYPTION_KEY=%s\n' "$checkpoint_key"
} >>"$env_tmp"

chown root:root "$env_tmp"
chmod 0600 "$env_tmp"
mv "$env_tmp" /etc/helmr/worker.env

%{ if worker_supports_build ~}
storage_dir=/var/lib/helmr/storage
cache_mount=/var/lib/helmr/cache
scratch_mount=/var/lib/helmr/scratch
cache_backing="$storage_dir/build-cache.ext4"
scratch_backing="$storage_dir/build-scratch.ext4"
cache_usable_bytes=$((${build_cache_mib} * 1048576))
scratch_usable_bytes=$((${build_scratch_mib} * 1048576))
filesystem_headroom_bytes=$((256 * 1048576))
cache_raw_bytes=$((cache_usable_bytes + filesystem_headroom_bytes))
scratch_raw_bytes=$((scratch_usable_bytes + filesystem_headroom_bytes))
required_free_bytes=$((${worker_disk_reserve_mib} * 1048576))

for path in "$storage_dir" "$cache_mount" "$scratch_mount" "$cache_backing" "$scratch_backing"; do
  [ ! -L "$path" ] || {
    echo "$path must not be a symlink" >&2
    exit 1
  }
done
install -d -m 0700 -o root -g root "$storage_dir"
install -d -m 0755 -o root -g root "$cache_mount" "$scratch_mount"
for mount_path in "$cache_mount" "$scratch_mount"; do
  if ! mountpoint -q "$mount_path" &&
    find "$mount_path" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    echo "$mount_path contains data on the parent filesystem" >&2
    exit 1
  fi
done
[ -e "$cache_backing" ] || required_free_bytes=$((required_free_bytes + cache_raw_bytes))
[ -e "$scratch_backing" ] || required_free_bytes=$((required_free_bytes + scratch_raw_bytes))
parent_available_bytes="$(df -B1 --output=avail /var/lib/helmr | tail -n 1 | tr -d ' ')"
[ "$parent_available_bytes" -ge "$required_free_bytes" ] || {
  echo "the root data extent cannot allocate both build filesystems while preserving its fixed reserve" >&2
  exit 1
}

prepare_backing() {
  path="$1"
  raw_bytes="$2"

  if [ -e "$path" ]; then
    [ -f "$path" ] || {
      echo "$path is not a regular backing file" >&2
      exit 1
    }
    [ "$(stat -c %s "$path")" -eq "$raw_bytes" ] || {
      echo "$path has an unexpected size; build filesystems are never resized in place" >&2
      exit 1
    }
  else
    fallocate --posix -l "$raw_bytes" "$path"
    mkfs.ext4 -F -q -m 0 -T largefile4 \
      -E nodiscard,lazy_itable_init=0,lazy_journal_init=0 "$path"
  fi

  allocated_bytes=$(($(stat -c %b "$path") * 512))
  [ "$allocated_bytes" -eq "$raw_bytes" ] || {
    echo "$path allocation does not equal its configured raw size" >&2
    exit 1
  }
  [ "$(blkid -p -s TYPE -o value "$path")" = ext4 ] || {
    echo "$path is not an ext4 filesystem" >&2
    exit 1
  }
}

prepare_backing "$cache_backing" "$cache_raw_bytes"
prepare_backing "$scratch_backing" "$scratch_raw_bytes"

cat >/etc/systemd/system/var-lib-helmr-cache.mount <<'EOF'
[Unit]
Description=Helmr build cache filesystem
Before=helmr-buildkit.service ${worker_service_name}.service

[Mount]
What=/var/lib/helmr/storage/build-cache.ext4
Where=/var/lib/helmr/cache
Type=ext4
Options=loop,nosuid,nodev,nodiscard

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/var-lib-helmr-scratch.mount <<'EOF'
[Unit]
Description=Helmr build scratch filesystem
Before=${worker_service_name}.service

[Mount]
What=/var/lib/helmr/storage/build-scratch.ext4
Where=/var/lib/helmr/scratch
Type=ext4
Options=loop,nosuid,nodev,nodiscard

[Install]
WantedBy=multi-user.target
EOF

install -d -m 0755 "/etc/systemd/system/${worker_service_name}.service.d"
cat >"/etc/systemd/system/${worker_service_name}.service.d/20-build-storage.conf" <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/helmr/cache /var/lib/helmr/scratch
After=var-lib-helmr-cache.mount var-lib-helmr-scratch.mount
EOF
%{ endif ~}

cat >/usr/local/bin/helmr-asg-lifecycle <<'EOF'
#!/bin/sh
set -eu

asg_name='${autoscaling_group_name}'
launch_hook='${launch_lifecycle_hook_name}'
launch_timeout='${launch_readiness_timeout_seconds}'
termination_hook='${termination_lifecycle_hook_name}'
drain_timeout='${termination_drain_timeout_seconds}s'
heartbeat_interval='${lifecycle_heartbeat_interval_seconds}'
worker_binary='${worker_binary_path}'
env_file=/etc/helmr/worker.env
drain_marker='${worker_work_dir}/drain-complete'
metadata_url=http://169.254.169.254/latest
launch_started_at="$(cat /run/helmr-launch-started-at 2>/dev/null || date +%s)"

metadata_token() {
  curl -fsS -X PUT "$metadata_url/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600"
}

metadata_get() {
  path="$1"
  token="$(metadata_token)"
  curl -fsS -H "X-aws-ec2-metadata-token: $token" "$metadata_url/$path"
}

instance_id() {
  metadata_get meta-data/instance-id
}

target_lifecycle_state() {
  metadata_get meta-data/autoscaling/target-lifecycle-state 2>/dev/null || true
}

aws_region() {
  metadata_get dynamic/instance-identity/document | sed -n 's/.*"region"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

export AWS_REGION="$(aws_region)"
export AWS_DEFAULT_REGION="$AWS_REGION"

complete_lifecycle_action() {
  hook="$1"
  result="$2"
  if [ -z "$hook" ]; then
    return 0
  fi
  aws autoscaling complete-lifecycle-action \
    --auto-scaling-group-name "$asg_name" \
    --lifecycle-hook-name "$hook" \
    --instance-id "$(instance_id)" \
    --lifecycle-action-result "$result" >/dev/null
}

record_heartbeat() {
  hook="$1"
  if [ -z "$hook" ]; then
    return 0
  fi
  aws autoscaling record-lifecycle-action-heartbeat \
    --auto-scaling-group-name "$asg_name" \
    --lifecycle-hook-name "$hook" \
    --instance-id "$(instance_id)" >/dev/null
}

load_worker_env() {
  if [ -f "$env_file" ]; then
    set -a
    . "$env_file"
    set +a
  fi
}

complete_launch() {
  if [ -z "$launch_hook" ]; then
    return 0
  fi
%{ if worker_supports_build ~}
  systemctl is-active --quiet 'helmr-buildkit.service'
%{ endif ~}
  systemctl is-active --quiet '${worker_service_name}'
  load_worker_env
  "$worker_binary" status >/dev/null
  complete_lifecycle_action "$launch_hook" CONTINUE
}

drain_and_complete_termination() {
	if [ -f "$drain_marker" ]; then
		complete_lifecycle_action "$termination_hook" CONTINUE
		return 0
	fi
  load_worker_env
  "$worker_binary" drain --timeout "$drain_timeout" >/var/log/helmr-worker-drain.log 2>&1 &
  drain_pid="$!"
  while kill -0 "$drain_pid" 2>/dev/null; do
    record_heartbeat "$termination_hook" || true
    sleep "$heartbeat_interval"
  done
  if wait "$drain_pid"; then
    complete_lifecycle_action "$termination_hook" CONTINUE
  else
    if "$worker_binary" fence >>/var/log/helmr-worker-drain.log 2>&1; then
      complete_lifecycle_action "$termination_hook" CONTINUE
    else
      echo "worker drain failed and durable fence could not be persisted" >>/var/log/helmr-worker-drain.log
      exit 1
    fi
  fi
}

case "$${1:-watch}" in
  complete-launch)
    complete_launch
    ;;
  watch)
    launch_completed=0
    while :; do
      if [ "$launch_completed" -eq 0 ]; then
        if complete_launch; then
          launch_completed=1
        else
          now="$(date +%s)"
          if [ $((now - launch_started_at)) -ge "$launch_timeout" ]; then
            complete_lifecycle_action "$launch_hook" ABANDON || true
            exit 1
          fi
          record_heartbeat "$launch_hook" || true
        fi
      fi
      state="$(target_lifecycle_state)"
      case "$state" in
        Terminated|Warmed:Terminated)
          drain_and_complete_termination
          exit 0
          ;;
      esac
      sleep 15
    done
    ;;
  *)
    echo "usage: helmr-asg-lifecycle [complete-launch|watch]" >&2
    exit 2
    ;;
esac
EOF
chmod 0755 /usr/local/bin/helmr-asg-lifecycle

%{ if worker_supports_build ~}
install -d -m 0755 /etc/systemd/system/helmr-buildkit.service.d
cat >/etc/systemd/system/helmr-buildkit.service.d/10-network-policy.conf <<'EOF'
[Service]
BindReadOnlyPaths=/etc/helmr/guest-resolv.conf:/etc/resolv.conf
ExecStart=
ExecStart=/usr/local/bin/rootlesskit --net=slirp4netns --cidr=${buildkit_slirp_cidr} --copy-up=/etc --disable-host-loopback /usr/local/bin/buildkitd --addr unix:///run/helmr/buildkit/buildkitd.sock --root /var/lib/helmr/cache/buildkit --oci-worker=true --oci-worker-snapshotter=fuse-overlayfs
%{ for cidr in buildkit_service_blocked_ipv4_cidrs ~}
IPAddressDeny=${cidr}
%{ endfor ~}
%{ for cidr in buildkit_service_blocked_ipv6_cidrs ~}
IPAddressDeny=${cidr}
%{ endfor ~}
EOF

cat >/etc/systemd/system/helmr-buildkit.service.d/20-resource-limits.conf <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/helmr/cache
After=var-lib-helmr-cache.mount

[Service]
Delegate=yes
CPUQuota=100%
MemoryMax=2G
MemorySwapMax=0
TasksMax=1024
MemoryOOMGroup=yes
EOF
%{ else ~}
install -d -m 0755 "/etc/systemd/system/${worker_service_name}.service.d"
cat >"/etc/systemd/system/${worker_service_name}.service.d/20-run-only.conf" <<'EOF'
[Unit]
Wants=
After=
After=network-online.target
EOF
%{ endif ~}

cat >/etc/systemd/system/helmr-asg-lifecycle.service <<'EOF'
[Unit]
Description=Helmr Auto Scaling lifecycle integration
After=network-online.target%{ if worker_supports_build } helmr-buildkit.service%{ endif } ${worker_service_name}.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/helmr-asg-lifecycle watch
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
%{ if worker_supports_build ~}
systemctl enable --now var-lib-helmr-cache.mount var-lib-helmr-scratch.mount

cache_source="$(findmnt -n -o SOURCE --target /var/lib/helmr/cache)"
scratch_source="$(findmnt -n -o SOURCE --target /var/lib/helmr/scratch)"
cache_device="$(findmnt -n -o MAJ:MIN --target /var/lib/helmr/cache)"
scratch_device="$(findmnt -n -o MAJ:MIN --target /var/lib/helmr/scratch)"
parent_device="$(findmnt -n -o MAJ:MIN --target /var/lib/helmr)"
[ "$cache_source" != "$scratch_source" ] &&
  [ "$cache_device" != "$scratch_device" ] &&
  [ "$cache_device" != "$parent_device" ] &&
  [ "$scratch_device" != "$parent_device" ] || {
  echo "build cache and scratch must be distinct mounted filesystems" >&2
  exit 1
}
losetup -j "$cache_backing" | cut -d: -f1 | grep -Fx "$cache_source" >/dev/null || {
  echo "build cache mount source does not match its backing file" >&2
  exit 1
}
losetup -j "$scratch_backing" | cut -d: -f1 | grep -Fx "$scratch_source" >/dev/null || {
  echo "build scratch mount source does not match its backing file" >&2
  exit 1
}
[ "$(df -B1 --output=avail "$cache_mount" | tail -n 1 | tr -d ' ')" -ge "$cache_usable_bytes" ] || {
  echo "build cache filesystem has less usable capacity than configured" >&2
  exit 1
}
[ "$(df -B1 --output=avail "$scratch_mount" | tail -n 1 | tr -d ' ')" -ge "$scratch_usable_bytes" ] || {
  echo "build scratch filesystem has less usable capacity than configured" >&2
  exit 1
}
for path in "$cache_mount/buildkit" "$scratch_mount/worker" "$scratch_mount/jailer"; do
  [ ! -L "$path" ] || {
    echo "$path must not be a symlink" >&2
    exit 1
  }
done
install -d -m 0755 "$cache_mount/buildkit" "$scratch_mount/worker" "$scratch_mount/jailer"

"$worker_binary" release install \
  --store '${platform_store_uri}' \
  --digest '${build_policy_digest}' \
  --output /etc/helmr/build-policy.json
systemctl enable --now helmr-buildkit.service
%{ else ~}
systemctl disable --now helmr-buildkit.service || true
%{ endif ~}
install -d -m 0755 '/etc/systemd/system/${worker_service_name}.service.d'
cat >'/etc/systemd/system/${worker_service_name}.service.d/10-entry.conf' <<'EOF'
[Service]
ExecStart=
ExecStart=${worker_binary_path}
EOF
systemctl daemon-reload
systemctl enable --now '${worker_service_name}'
systemctl enable --now helmr-asg-lifecycle.service
