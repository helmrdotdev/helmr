#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  apparmor \
  ca-certificates \
  cloud-guest-utils \
  curl \
  e2fsprogs \
  gpgv \
  iproute2 \
  jq \
  kmod \
  nftables \
  patchelf \
  squashfs-tools \
  tar \
  unzip \
  util-linux \
  xz-utils

work=$(mktemp -d /dev/shm/helmr-worker-image.XXXXXX)
trap 'rm -rf "$work"' EXIT
chmod 0700 "$work"
cat >"$work/helmr-prepare-root" <<'HELMR_PREPARE_ROOT'
${prepare_root_script}
HELMR_PREPARE_ROOT
printf '%s  %s\n' '${prepare_root_digest}' "$work/helmr-prepare-root" | sha256sum -c -
cat >"$work/install-worker-host" <<'HELMR_INSTALL_HOST'
${install_host_script}
HELMR_INSTALL_HOST
printf '%s  %s\n' '${install_host_digest}' "$work/install-worker-host" | sha256sum -c -

aws_cli_version=2.31.39
aws_cli_digest=5a2ad4e63f8f687d735f8e7a132b3622a1cf08fa884c53e3423c9b83a3c0d663
curl -fsSL --retry 3 \
  "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-$${aws_cli_version}.zip" \
  -o "$work/awscliv2.zip"
printf '%s  %s\n' "$aws_cli_digest" "$work/awscliv2.zip" | sha256sum -c -
unzip -q "$work/awscliv2.zip" -d "$work/awscli"
aws_cli_install="/usr/local/aws-cli/v2/$aws_cli_version"
install -d -m 0755 "$aws_cli_install/bin" /usr/local/bin
cp -a "$work/awscli/aws/dist" "$aws_cli_install/dist"
ln -s ../dist/aws "$aws_cli_install/bin/aws"
ln -s ../dist/aws_completer "$aws_cli_install/bin/aws_completer"
ln -s "$aws_cli_install" /usr/local/aws-cli/v2/current
ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws
ln -s /usr/local/aws-cli/v2/current/bin/aws_completer /usr/local/bin/aws_completer
test "$(aws --version 2>&1 | awk '{print $1}')" = "aws-cli/$aws_cli_version"

aws s3 cp '${host_artifacts_bundle_s3_uri}' "$work/worker-host-artifacts.tar"
aws s3 cp '${runtime_artifacts_bundle_s3_uri}' "$work/runtime-artifacts.tar"
bash "$work/install-worker-host" install \
  "$work/worker-host-artifacts.tar" '${host_artifacts_bundle_digest}' '${host_artifacts_manifest_digest}' \
  "$work/runtime-artifacts.tar" '${runtime_artifacts_bundle_digest}' '${runtime_artifacts_manifest_digest}' \
  "$work/helmr-prepare-root"
apt-get clean
rm -rf /var/lib/apt/lists/*
