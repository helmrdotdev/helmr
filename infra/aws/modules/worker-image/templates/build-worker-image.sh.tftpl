#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export HOME=/root
export USER=root

apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  docker.io \
  e2fsprogs \
  git \
  iproute2 \
  jq \
  apparmor \
  nftables \
  python3-minimal \
  sudo \
  unzip \
  util-linux \
  uidmap \
  xz-utils

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

if [ ! -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  install -d -m 0755 /nix
  curl -fsSL https://nixos.org/nix/install | sh -s -- --daemon --yes
fi

# shellcheck disable=SC1091
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh

export NIX_CONFIG="experimental-features = nix-command flakes"
systemctl enable --now docker

repo=/opt/helmr-src
rm -rf "$repo"
%{ if source_bundle_s3_uri != "" ~}
aws s3 cp '${source_bundle_s3_uri}' /tmp/helmr-source.bundle
git clone /tmp/helmr-source.bundle "$repo"
%{ else ~}
git clone '${source_repository_url}' "$repo"
%{ endif ~}
git -C "$repo" checkout '${source_ref}'

cd "$repo"
nix develop .#smoke-linux -c bash -euo pipefail <<'EOF'
retry() {
  local attempts=$1
  shift
  local delay=5
  local attempt=1
  while true; do
    if "$@"; then
      return 0
    fi
    if [ "$attempt" -ge "$attempts" ]; then
      return 1
    fi
    sleep "$delay"
    attempt=$((attempt + 1))
    delay=$((delay * 2))
  done
}

install -d -m 0755 /usr/local/bin
bun install --frozen-lockfile --ignore-scripts
make console-build
retry 4 go mod download
GOFLAGS='' CGO_ENABLED=0 go build -tags embed_console -o /usr/local/bin/helmr-worker ./cmd/helmr-worker
GOFLAGS='' go build -tags embed_console -o /usr/local/bin/helmr ./cmd/helmr
GOFLAGS='' go build -tags embed_console -o /usr/local/bin/helmr-controlplane ./cmd/helmr-controlplane
GOFLAGS='' go build -tags embed_console -o /usr/local/bin/helmr-dispatcher ./cmd/helmr-dispatcher
make images

install -m 0755 "$(command -v firecracker)" /usr/local/bin/firecracker
install -m 0755 "$(command -v jailer)" /usr/local/bin/jailer
install -m 0755 "$(command -v gpgv)" /usr/local/bin/gpgv
install -m 0755 "$(command -v mksquashfs)" /usr/local/bin/mksquashfs
install -m 0755 "$(command -v patchelf)" /usr/local/bin/patchelf
install -m 0755 "$(command -v xz)" /usr/local/bin/xz
EOF

install -d -m 0755 /var/lib/helmr/images/guest
rm -rf /var/lib/helmr/images/guest/out
cp -R "$repo/images/guest/out" /var/lib/helmr/images/guest/out

groupadd --system --gid 1001 helmr-vmm 2>/dev/null || true
useradd --system --uid 1001 --gid 1001 --groups kvm --no-create-home --shell /usr/sbin/nologin helmr-vmm 2>/dev/null || true
groupadd --system helmr-verifier 2>/dev/null || true
useradd --system --gid helmr-verifier --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin helmr-verifier 2>/dev/null || true
cat >/etc/udev/rules.d/99-helmr-kvm.rules <<'EOF'
KERNEL=="kvm", GROUP="helmr-vmm", MODE="0660"
EOF
if [ -e /dev/kvm ]; then
  chgrp helmr-vmm /dev/kvm || true
  chmod 0660 /dev/kvm || true
fi

install -d -m 0755 /run/helmr /etc/helmr /var/lib/helmr /var/lib/helmr/jailer
cat >/etc/systemd/system/helmr-worker.service <<'EOF'
[Unit]
Description=Helmr worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/helmr/worker.env
ExecStart=/usr/local/bin/helmr-worker
Restart=on-failure
RestartSec=5
Delegate=yes
DelegateSubgroup=supervisor
KillMode=mixed
TasksMax=infinity

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/sysctl.d/99-helmr-firecracker.conf <<'EOF'
net.ipv4.ip_forward = 1
user.max_user_namespaces = 16384
EOF

systemctl daemon-reload
