#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  apparmor \
  ca-certificates \
  cloud-guest-utils \
  curl \
  e2fsprogs \
  gpgv \
  iproute2 \
  jq \
  nftables \
  patchelf \
  squashfs-tools \
  tar \
  unzip \
  util-linux \
  xz-utils

work=/dev/shm/helmr-worker-image
rm -rf "$work"
install -d -m 0700 "$work/host" "$work/runtime"

cat >"$work/helmr-prepare-root" <<'HELMR_PREPARE_ROOT'
${prepare_root_script}
HELMR_PREPARE_ROOT
printf '%s  %s\n' '${prepare_root_digest}' "$work/helmr-prepare-root" | sha256sum -c -
install -d -m 0755 /usr/local/sbin
install -m 0755 "$work/helmr-prepare-root" /usr/local/sbin/helmr-prepare-root

aws_cli_version=2.31.39
aws_cli_digest=5a2ad4e63f8f687d735f8e7a132b3622a1cf08fa884c53e3423c9b83a3c0d663
curl -fsSL --retry 3 \
  "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-$${aws_cli_version}.zip" \
  -o "$work/awscliv2.zip"
printf '%s  %s\n' "$aws_cli_digest" "$work/awscliv2.zip" | sha256sum -c -
unzip -q "$work/awscliv2.zip" -d "$work/awscli"
aws_cli_install="/usr/local/aws-cli/v2/$aws_cli_version"
install -d -m 0755 "$aws_cli_install/bin" /usr/local/bin
cp -a "$work/awscli/aws/dist" "$aws_cli_install/dist"
ln -s ../dist/aws "$aws_cli_install/bin/aws"
ln -s ../dist/aws_completer "$aws_cli_install/bin/aws_completer"
ln -s "$aws_cli_install" /usr/local/aws-cli/v2/current
ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws
ln -s /usr/local/aws-cli/v2/current/bin/aws_completer /usr/local/bin/aws_completer
test "$(aws --version 2>&1 | awk '{print $1}')" = "aws-cli/$aws_cli_version"

aws s3 cp '${host_artifacts_bundle_s3_uri}' "$work/worker-host-artifacts.tar"
printf '%s  %s\n' '${host_artifacts_bundle_digest}' "$work/worker-host-artifacts.tar" | sha256sum -c -
expected_host_artifacts="$(printf '%s\n' firecracker helmr-worker jailer worker-host-artifacts.json)"
actual_host_artifacts="$(tar -tf "$work/worker-host-artifacts.tar")"
test "$actual_host_artifacts" = "$expected_host_artifacts"
tar --no-same-owner --no-same-permissions -C "$work/host" -xf "$work/worker-host-artifacts.tar"

printf '%s  %s\n' '${host_artifacts_manifest_digest}' "$work/host/worker-host-artifacts.json" | sha256sum -c -
jq -e \
  --arg source_commit '${source_ref}' '
  (keys | sort) == ["arch", "files", "schema", "sourceCommit", "workerVersion"] and
  .schema == "helmr.worker-host-artifacts.v0" and
  .arch == "amd64" and
  .sourceCommit == $source_commit and
  .workerVersion == $source_commit and
  [.files[].path] == ["firecracker", "helmr-worker", "jailer"] and
  all(.files[];
    .mode == "0755" and
    (.size_bytes | type == "number" and . > 0) and
    (.digest | test("^sha256:[0-9a-f]{64}$")))
' "$work/host/worker-host-artifacts.json" >/dev/null

while IFS=$'\t' read -r path digest size_bytes mode; do
  file="$work/host/$path"
  test -f "$file" && test ! -L "$file"
  test "$(sha256sum "$file" | awk '{print $1}')" = "$${digest#sha256:}"
  test "$(stat -c %s "$file")" = "$size_bytes"
  test "$(stat -c %a "$file")" = "$${mode#0}"
done < <(jq -r '.files[] | [.path, .digest, .size_bytes, .mode] | @tsv' "$work/host/worker-host-artifacts.json")

aws s3 cp '${runtime_artifacts_bundle_s3_uri}' "$work/runtime-artifacts.tar"
printf '%s  %s\n' '${runtime_artifacts_bundle_digest}' "$work/runtime-artifacts.tar" | sha256sum -c -
expected_runtime_artifacts="$(printf '%s\n' initramfs rootfs.ext4 runtime-artifacts.json vmlinuz)"
actual_runtime_artifacts="$(tar -tf "$work/runtime-artifacts.tar")"
test "$actual_runtime_artifacts" = "$expected_runtime_artifacts"
tar --no-same-owner --no-same-permissions -C "$work/runtime" -xf "$work/runtime-artifacts.tar"
printf '%s  %s\n' '${runtime_artifacts_manifest_digest}' "$work/runtime/runtime-artifacts.json" | sha256sum -c -

install -d -m 0755 /usr/local/bin /usr/share/helmr /var/lib/helmr/images/guest/out
for name in firecracker helmr-worker jailer; do
  install -m 0755 "$work/host/$name" "/usr/local/bin/$name"
done
install -m 0644 "$work/host/worker-host-artifacts.json" /usr/share/helmr/worker-host-artifacts.json
for name in initramfs rootfs.ext4 runtime-artifacts.json vmlinuz; do
  install -m 0600 "$work/runtime/$name" "/var/lib/helmr/images/guest/out/$name"
done
rm -rf "$work"

groupadd --system --gid 1001 helmr-vmm 2>/dev/null || true
useradd --system --uid 1001 --gid 1001 --groups kvm --no-create-home --shell /usr/sbin/nologin helmr-vmm 2>/dev/null || true
groupadd --system helmr-verifier 2>/dev/null || true
useradd --system --gid helmr-verifier --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin helmr-verifier 2>/dev/null || true
cat >/etc/udev/rules.d/99-helmr-kvm.rules <<'EOF'
KERNEL=="kvm", GROUP="helmr-vmm", MODE="0660"
EOF
if [ -e /dev/kvm ]; then
  chgrp helmr-vmm /dev/kvm || true
  chmod 0660 /dev/kvm || true
fi

install -d -m 0755 /run/helmr /etc/helmr /var/lib/helmr /var/lib/helmr/jailer
cat >/etc/systemd/system/helmr-worker.service <<'EOF'
[Unit]
Description=Helmr worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/helmr/worker.env
ExecStart=/usr/local/bin/helmr-worker
Restart=on-failure
RestartSec=5
Delegate=yes
DelegateSubgroup=supervisor
KillMode=mixed
TasksMax=infinity

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/sysctl.d/99-helmr-firecracker.conf <<'EOF'
net.ipv4.ip_forward = 1
user.max_user_namespaces = 16384
EOF

apt-get clean
rm -rf /var/lib/apt/lists/*
systemctl daemon-reload
