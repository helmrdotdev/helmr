const pad = ".".repeat(10);
const tooth = (t: string, last: string) => pad + t + t + t + last + pad;
const wall = pad + "#" + ".".repeat(26) + "#" + pad;
const chimney = ".".repeat(36) + "##" + ".".repeat(10);
const factoryRows = [
  ".".repeat(48),
  ".".repeat(48),
  chimney,
  chimney,
  chimney,
  tooth("##.....", "##...##"),
  tooth("#.##...", "#.##.##"),
  tooth("#...##.", "#...###"),
  tooth("#.....#", "#....##"),
  pad + "#".repeat(28) + pad,
  wall, wall, wall, wall, wall,
  "#.#.#.#.#." + "#" + ".".repeat(26) + "#" + ".#.#.#.#.#",
  wall, wall,
  "#".repeat(48),
];

for (const row of factoryRows) {
  if (row.length !== 48) {
    throw new Error(`Factory scene row must be 48 cells, got ${row.length}`);
  }
}

const factoryPixels = pixelsFromRows(factoryRows);
---

<BaseLayout
  title="Helmr — The code-first runtime for AI agents"
  socialTitle="The code-first runtime for AI agents"
  description="The code-first runtime for AI agents. Define agent workloads in TypeScript and run them in isolated Linux microVMs with durable workspaces, scoped secrets, human or external waitpoints, logs, and run history."
  path="/"
  jsonLd={[softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}
>
  <div class="landing">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <h1 class="headline hero-title">Build your own software factory.</h1>
          <p class="hero-lede">
            Infrastructure and APIs for your own agent harness.
            <br />Your agents. Your workflows. Your rules.
          </p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="/docs/quickstart">Start building</a>
            <a class="hero-link" href="https://github.com/helmrdotdev/helmr" target="_blank" rel="noopener">
              View on GitHub
              <svg class="hero-link-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M5 11L11 5M6 5H11V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </a>
          </div>
          <button class="install-command" type="button" data-copy-install aria-label="Copy install command">
            <code data-install-command>curl -fsSL https://helmr.dev/install | bash</code>
            <span class="copy-control" aria-hidden="true">
              <svg class="copy-icon" viewBox="0 0 24 24" fill="none">
                <path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none">
                <path d="M2.75 15.0938L9 20.25L21.25 3.75" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
              </svg>
            </span>
          </button>
        </div>
        <figure class="hero-figure" aria-hidden="true">
          <div class="hero-print">
            <canvas data-print></canvas>
          </div>
          <figcaption>fig. 01 &mdash; steady at the helm</figcaption>
        </figure>
      </div>
    </section>

    <section id="build" class="build-section" aria-label="What you can build">
      <div class="section-head">
        <h2 class="headline section-title">
          What you can build.
          <span class="faint">Your own Devin — with your agent, in your interface.</span>
        </h2>
        <p class="section-note">
          Devin, Cursor Cloud and Codex Cloud ship a background agent as a
          finished product. Helmr gives you the same capability as
          infrastructure: bring any agent, plug in any interface, and the rest —
          isolated VMs, durable workspaces, waits for approval — is already
          there.
        </p>
      </div>
      <div class="equation" data-equation>
        <div class="equation-inputs">
          <div class="eq-slot panel panel-screen">
            <div class="code-cap">
              <span>your agent</span>
              <span class="cap-meta">pick one</span>
            </div>
            <div class="eq-body">
              {runtimeVariants.map((harness, index) => (
                <button
                  type="button"
                  class="harness-chip"
                  data-eq-agent={harness.key}
                  data-name={harness.key === "own" ? "custom" : harness.name}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {harness.icon ? (
                    <img src={harness.icon} alt="" width="16" height="16" />
                  ) : (
                    <svg class="harness-chip-pixel" viewBox="0 0 10 10" aria-hidden="true">
                      {boltPixels.map((pixel) => (
                        <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                      ))}
                    </svg>
                  )}
                  <span>{harness.name}</span>
                </button>
              ))}
            </div>
          </div>
