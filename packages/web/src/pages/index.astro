  usecase: { tone: "pink", strong: "#a8618a" },
  agent: { tone: "blue", strong: "#5079e4" },
  interface: { tone: "yellow", strong: "#ad8226" },
} as const;

const codeTags = (
  [
    ["usecase", "usecase.head"],
    ["agent", "agent.body"],
    ["interface", "interface.lines"],
  ] as const
).map(([region, seg]) => ({
  region,
  seg,
  ...regionStyle[region],
  ...tagPicks[region][codePick[region]]!,
  line: initialCodeLines.findIndex((line) => line.seg === seg) + 1,
}));

const usecaseChips = usecases.map((usecase) => ({
  ...usecase,
  pixels: pixelsFromRows(pixelIcons[usecase.icon]),
}));

const wireRequests = {
  vm: `GET /repos/acme/app/pulls/482
Host: api.github.com
Authorization: Bearer <span class="tok-placeholder">hlmr_p_3f9c…e21a</span>`,
  allowed: `GET /repos/acme/app/pulls/482
Host: api.github.com
Authorization: Bearer <span class="tok-real">ghp_••••••••••••••••</span>`,
  other: `POST /collect
Host: telemetry.example
Authorization: Bearer <span class="tok-placeholder">hlmr_p_3f9c…e21a</span>`,
};

---

<BaseLayout
  title="Helmr — The code-first runtime for AI agents"
  socialTitle="The code-first runtime for AI agents"
  description="The code-first runtime for AI agents. Define agent workloads in TypeScript and run them in isolated Linux microVMs with durable workspaces, scoped secrets, human or external waitpoints, logs, and run history."
  path="/"
  jsonLd={[softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}
>
  <div class="landing">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <h1 class="headline hero-title">Build your own software factory.</h1>
          <p class="hero-lede">
            Infrastructure and APIs for your own agent harness.
            <br />Your agents. Your workflows. Your rules.
          </p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="/docs/quickstart">Start building</a>
            <a class="hero-link" href="https://github.com/helmrdotdev/helmr" target="_blank" rel="noopener">
              View on GitHub
              <svg class="hero-link-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M5 11L11 5M6 5H11V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </a>
          </div>
          <button class="install-command" type="button" data-copy-install aria-label="Copy install command">
            <code data-install-command>curl -fsSL https://helmr.dev/install | bash</code>
            <span class="copy-control" aria-hidden="true">
              <svg class="copy-icon" viewBox="0 0 24 24" fill="none">
                <path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none">
                <path d="M2.75 15.0938L9 20.25L21.25 3.75" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
              </svg>
            </span>
          </button>
        </div>
        <figure class="hero-figure" aria-hidden="true">
          <div class="hero-print">
            <canvas data-print></canvas>
          </div>
          <figcaption>fig. 01 &mdash; steady at the helm</figcaption>
        </figure>
      </div>
    </section>

    <section id="runtime" class="build-section" aria-label="Assemble the factory yourself">
      <div class="section-head">
        <h2 class="headline section-title">
          Assemble the factory yourself.
          <span class="faint">It's all TypeScript, so nothing is fixed.</span>
        </h2>
        <p class="section-note">
          Devin, Cursor Cloud and Codex Cloud ship the agent as a finished
          product. Helmr ships it as infrastructure: every part is a TypeScript
          value you pick, swap, or write yourself. Change a part below and the
          file rewires itself.
        </p>
      </div>
      <div class="choices">
        <div class="choice">
          <div class="choice-copy">
            <p class="choice-title">Any job.</p>
            <p class="choice-sub">A one-shot task, a durable actor session, or a cron schedule.</p>
          </div>
          <div class="choice-chips" data-pick="usecase" style={`--chip-tint: ${tints[regionStyle.usecase.tone]}`}>
            {usecaseChips.map((usecase) => (
              <button
                type="button"
                class="harness-chip choice-chip"
                data-key={usecase.key}
                aria-pressed={usecase.key === codePick.usecase ? "true" : "false"}
              >
                <svg class="harness-chip-pixel" viewBox="0 0 10 10" aria-hidden="true">
                  {usecase.pixels.map((pixel) => (
                    <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                  ))}
                </svg>
                <span>{usecase.name}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="choice">
          <div class="choice-copy">
            <p class="choice-title">Any agent.</p>
            <p class="choice-sub">Claude Code, Codex, an open harness on a cheap model, or the loop you wrote yourself.</p>
          </div>
          <div class="choice-chips" data-pick="agent" style={`--chip-tint: ${tints[regionStyle.agent.tone]}`}>
            {harnesses.map((harness) => (
              <button
                type="button"
                class="harness-chip choice-chip"
                data-key={harness.key}
                aria-pressed={harness.key === codePick.agent ? "true" : "false"}
              >
                {harness.icon ? (
                  <img src={harness.icon} alt="" width="16" height="16" />
                ) : (
                  <svg class="harness-chip-pixel" viewBox="0 0 10 10" aria-hidden="true">
                    {boltPixels.map((pixel) => (
                      <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                    ))}
                  </svg>
                )}
                <span>{harness.name}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="choice">
          <div class="choice-copy">
            <p class="choice-title">Any interface.</p>
            <p class="choice-sub">Wherever your team already works. Helmr is the runtime behind it, not the chat window in front.</p>
          </div>
          <div class="choice-chips" data-pick="interface" style={`--chip-tint: ${tints[regionStyle.interface.tone]}`}>
            {interfaces.map((iface) => (
              <button
                type="button"
                class="harness-chip choice-chip"
                data-key={iface.key}
                aria-pressed={iface.key === codePick.interface ? "true" : "false"}
              >
                {iface.icon ? (
                  <img src={iface.icon} alt="" width="15" height="15" />
                ) : (
                  <svg class="harness-chip-pixel" viewBox="0 0 10 10" aria-hidden="true">
                    {windowPixels.map((pixel) => (
                      <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                    ))}
                  </svg>
                )}
                <span>{iface.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <div class="code-frame panel panel-screen" data-code-frame>
        <div class="code-cap">
          <span data-code-file>{codeParts.usecases[codePick.usecase]!.file}</span>
          <span class="cap-meta" data-code-meta>{harnesses.find((h) => h.key === codePick.agent)!.meta}</span>
        </div>
        <pre><code data-code-body>{initialCodeLines.map((line, i) => (
          <span class="cl" data-region={line.region}><span class="ln">{String(i + 1).padStart(2, " ")}</span><span class="lc" set:html={line.html}></span></span>
        ))}</code></pre>
        <div class="code-tags" aria-hidden="true">
          {codeTags.map((tag) => (
            <span
              class={`code-tag code-tag-${tag.region}`}
              data-tag-region={tag.region}
              data-tag-seg={tag.seg}
              style={`--line: ${tag.line}; --tag-strong: ${tag.strong}; background: ${tints[tag.tone]}`}
            >
              <span class="code-tag-icon" set:html={tag.icon} />
              <span class="code-tag-label">{tag.label}</span>
            </span>
          ))}
        </div>
      </div>
      <script is:inline type="application/json" data-code-parts set:html={JSON.stringify({ parts: codeParts, recipe: codeRecipe, pick: codePick, tagPicks }).replaceAll("<", "\\u003c")} />
    </section>

    <section id="primitives" class="features" aria-label="Task patterns">
      <div class="section-head">
        <h2 class="headline section-title">
          Workflows as functions.{" "}
          <span class="faint">Typed in, typed out, durable in between.</span>
        </h2>
      </div>
      <div class="feature-grid">
        {renderedTaskFeatures.map((feature) => (
          <div class="feature">
            <div class="feature-head">
              <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints[feature.tone]}`}>
                {feature.pixels.map((pixel) => (
                  <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                ))}
              </svg>
              <h3 class="feature-title">{feature.title}</h3>
            </div>
            <div class="feature-panel panel panel-screen">
              <div class="code-cap">
                <span>{feature.label}</span>
                <span class="cap-meta">{feature.lang === "ts" ? "typescript" : "bash"}</span>
              </div>
              <pre><code set:html={feature.html}></code></pre>
            </div>
            <p class="feature-caption">{feature.caption}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="actor" class="actor-section" aria-label="Actor steering">
      <div class="section-head">
        <h2 class="headline section-title">
          {renderedActor.title}{" "}
          <span class="faint">Input and output, kept across Runs.</span>
        </h2>
      </div>
      <div class="pair-panels">
        <div class="paired-feature">
          <div class="feature-head">
            <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints.yellow}`}>
              {renderedActor.definePixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            <h3 class="feature-title">Define the Actor</h3>
          </div>
          <div class="feature-panel panel panel-screen">
            <div class="code-cap">
              <span>actor()</span>
              <span class="cap-meta">typescript</span>
            </div>
            <pre><code set:html={renderedActor.defineHtml}></code></pre>
          </div>
        </div>
        <div class="paired-feature">
          <div class="feature-head">
            <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints.blue}`}>
              {renderedActor.sendPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            <h3 class="feature-title">Send input and read output</h3>
          </div>
          <div class="feature-panel panel panel-screen">
            <div class="code-cap">
              <span>client.sessions.ref()</span>
              <span class="cap-meta">typescript</span>
            </div>
            <pre><code set:html={renderedActor.sendHtml}></code></pre>
          </div>
        </div>
      </div>
      <p class="feature-caption actor-caption">{renderedActor.caption}</p>
    </section>

    <section id="workspace" class="workspace-section" aria-label="Shared Workspace">
      <div class="section-head">
        <h2 class="headline section-title">
          Persistent VM filesystems.{" "}
          <span class="faint">The same /workspace, Run after Run.</span>
        </h2>
      </div>
      <div class="pair-panels workspace-panels">
        {renderedWorkspaceFeatures.map((feature) => (
          <div class="paired-feature workspace-feature">
            <div class="feature-head">
              <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints[feature.tone]}`}>
                {feature.pixels.map((pixel) => (
                  <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                ))}
              </svg>
              <h3 class="feature-title">{feature.title}</h3>
            </div>
            <div class="feature-panel panel panel-screen">
              <div class="code-cap">
                <span>{feature.label}</span>
                <span class="cap-meta">typescript</span>
              </div>
              <pre><code set:html={feature.html}></code></pre>
            </div>
            <p class="feature-caption">{feature.caption}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="security" class="security-section" aria-label="Security">
      <div class="section-head">
        <h2 class="headline section-title">
          The agent never sees the key.{" "}
          <span class="faint">Secrets are swapped in at the network boundary — outside the VM.</span>
        </h2>
      </div>
      <div class="wire">
        <div class="wire-panel panel panel-screen">
          <div class="code-cap">
            <span>inside the microVM</span>
            <span class="cap-meta">GH_TOKEN</span>
          </div>
          <pre class="wire-req" set:html={wireRequests.vm}></pre>
        </div>
        <div class="wire-boundary">
          <svg class="wire-mark" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints.blue}`}>
            {arrowRightPixels.map((pixel) => (
              <rect x={pixel.x} y={pixel.y} width="1" height="1" />
            ))}
          </svg>
        </div>
        <div class="wire-out">
          <div class="wire-panel panel panel-screen is-allowed">
            <div class="code-cap">
              <span>api.github.com</span>
              <span class="cap-meta">allowed origin</span>
            </div>
            <pre class="wire-req" set:html={wireRequests.allowed}></pre>
          </div>
          <div class="wire-panel panel panel-screen is-other">
            <div class="code-cap">
              <span>anywhere else</span>
              <span class="cap-meta">not allowed</span>
            </div>
            <pre class="wire-req" set:html={wireRequests.other}></pre>
          </div>
        </div>
      </div>
      <p class="wire-note">
        Bind a secret as <code>protected</code> and the VM only ever holds a
        placeholder. Helmr replaces it for the origins you allow, checks the run
        is still authorized, and fails the request if the secret was revoked.
        <a class="wire-docs" href="/docs/concepts/secrets">How protected secrets work →</a>
      </p>
    </section>

    <section class="homes" aria-label="Deployment options">
      <div class="section-head">
        <h2 class="headline section-title">
          Run on our cloud,{" "}
          <span class="faint">or in your AWS.</span>
        </h2>
        <p class="section-note mono">
          Early, open, Apache 2.0. Read the source before you trust it with your repos.
        </p>
        <div class="fact-row">
          <span class="fact-chip">apache-2.0</span>
          <span class="fact-chip">go control plane</span>
          <span class="fact-chip">typescript sdk</span>
          <span class="fact-chip">firecracker microVMs</span>
          <span class="fact-chip">opentofu modules</span>
        </div>
      </div>
      <div class="homes-grid">
        <div class="home-card home-card-cloud panel">
          <p class="home-label">
            <svg class="home-icon" viewBox="0 0 10 10" aria-hidden="true">
              {cloudPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            Helmr Cloud <span class="chip chip-warm">coming soon</span>
          </p>
          <p class="home-text">
            A managed fleet. Projects, environments, immutable deployments &mdash;
            no infrastructure to run.
          </p>
          <a class="btn btn-light" href="/docs">Read the docs</a>
        </div>
        <div class="home-card home-card-dark panel">
          <p class="home-label">
            <svg class="home-icon" viewBox="0 0 10 10" aria-hidden="true">
              {shieldPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            Your AWS account
          </p>
          <p class="home-text">
            The identical control plane and workers in your VPC, Apache 2.0.
            Credentials never leave your boundary.
          </p>
          <a class="btn btn-dark" href="/docs/self-hosting/overview">Self-hosting guide</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    import { mountDitherScene } from "../lib/dither-scene";

    const printCanvas = document.querySelector<HTMLCanvasElement>("[data-print]");
    if (printCanvas) {
      mountDitherScene(printCanvas, {
        horizonPx: 124,
        skyMax: 0.34,
        sun: false,
        frost: 1,
        animate: false,
      });
    }

    const copyInstallButton = document.querySelector("[data-copy-install]");
    const installCommand = document.querySelector("[data-install-command]");

    copyInstallButton?.addEventListener("click", async () => {
      const text = installCommand?.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      copyInstallButton.setAttribute("data-copied", "true");
      window.setTimeout(() => {
        copyInstallButton.removeAttribute("data-copied");
      }, 1600);
    });

    const codePartsScript = document.querySelector("[data-code-parts]");
    const codeBody = document.querySelector<HTMLElement>("[data-code-body]");
    if (codePartsScript && codeBody) {
      const { parts, recipe, pick, tagPicks } = JSON.parse(codePartsScript.textContent ?? "{}");
      const state = { ...pick };
      const fileEl = document.querySelector("[data-code-file]");
      const metaEl = document.querySelector("[data-code-meta]");
      const tags = Array.from(document.querySelectorAll<HTMLElement>("[data-tag-region]"));

      const segment = (key: string): string[] => {
        if (key === "blank") return ["&nbsp;"];
        const [scope, name] = key.split(".");
        if (scope === "agent") return parts.agents[state.agent][name];
        if (scope === "usecase") return parts.usecases[state.usecase][name];
        if (scope === "interface") {
          return parts.interfaces[state.interface][name];
        }
        return parts.fixed[name];
      };

      const lineTemplate = (() => {
        const template = codeBody.querySelector<HTMLElement>(".cl")!.cloneNode(true) as HTMLElement;
        template.removeAttribute("data-region");
        template.removeAttribute("data-flash");
        template.style.removeProperty("--flash");
        return template;
      })();
      const flashTints: Record<string, string> = {
        usecase: "rgba(168, 97, 138, 0.2)",
        agent: "rgba(80, 121, 228, 0.22)",
        interface: "rgba(173, 130, 38, 0.22)",
        fixed: "rgba(31, 31, 36, 0.1)",
      };
      let flashTimer: number | undefined;

      const renderCode = (changed?: Set<string>) => {
        const lines: { html: string; region: string | null; seg: string }[] = [];
        for (const [key, region] of recipe) {
          for (const html of segment(key)) lines.push({ html, region, seg: key });
        }
        const fragment = document.createDocumentFragment();
        lines.forEach((line, i) => {
          const cl = lineTemplate!.cloneNode(true) as HTMLElement;
          if (line.region) cl.dataset.region = line.region;
          else cl.removeAttribute("data-region");
          if (changed?.has(line.seg)) {
            cl.setAttribute("data-flash", "");
            cl.style.setProperty("--flash", flashTints[line.seg.split(".")[0]!]!);
          }
          cl.querySelector(".ln")!.textContent = String(i + 1).padStart(2, " ");
          cl.querySelector(".lc")!.innerHTML = line.html;
          fragment.appendChild(cl);
        });
        codeBody.replaceChildren(fragment);
        if (fileEl) fileEl.textContent = parts.usecases[state.usecase].file;
        if (metaEl) metaEl.textContent = parts.agents[state.agent].meta;
        for (const tag of tags) {
          const index = lines.findIndex((line) => line.seg === tag.dataset.tagSeg);
          tag.style.setProperty("--line", String(index + 1));
          const region = tag.dataset.tagRegion!;
          const picked = tagPicks[region][state[region as keyof typeof state]];
          tag.querySelector(".code-tag-icon")!.innerHTML = picked.icon;
          tag.querySelector(".code-tag-label")!.textContent = picked.label;
        }
        if (changed) {
          window.clearTimeout(flashTimer);
          flashTimer = window.setTimeout(() => {
            codeBody.querySelectorAll("[data-flash]").forEach((el) => el.removeAttribute("data-flash"));
          }, 1400);
        }
      };

      document.querySelectorAll<HTMLElement>("[data-pick]").forEach((group) => {
        const kind = group.dataset.pick as "usecase" | "agent" | "interface";
        const buttons = Array.from(group.querySelectorAll<HTMLElement>("button"));
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const key = button.dataset.key ?? "";
            if (!key || state[kind] === key) return;
            state[kind] = key;
            const changed = new Set<string>(
              recipe
                .filter(([, region]: [string, string | null]) => region === kind)
                .map(([seg]: [string]) => seg),
            );
            for (const item of buttons) {
              item.setAttribute("aria-pressed", item === button ? "true" : "false");
            }
            renderCode(changed);
          });
        });
      });
    }
  </script>
</BaseLayout>

<style>
  .landing {
    position: relative;
    overflow-x: clip;
    --editorial-bg: #fff;
    --editorial-rule: #dedede;
    background: var(--editorial-bg);
  }

  :global(body:has(.landing)),
  :global(body:has(.landing) .site-header),
  :global(body:has(.landing) .site-footer) {
    background: #fff;
  }

  :global(body:has(.landing)) {
    --landing-max-w: 80rem;
  }

  :global(body:has(.landing) .site-header) {
    border-bottom-color: #dedede;
  }

  :global(body:has(.landing) .site-nav) {
    max-width: var(--landing-max-w);
  }

  :global(body:has(.landing) .site-footer) {
    border-top-color: #dedede;
  }

  :global(body:has(.landing) .footer-inner) {
    max-width: var(--landing-max-w);
  }

  .landing :global(.panel-screen),
  .landing :global(.code-cap) {
    border-color: var(--editorial-rule);
    background: #fff;
  }

  section {
    max-width: var(--landing-max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    position: relative;
    max-width: none;
    padding: 0;
    border-bottom: 1px solid var(--editorial-rule);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    align-items: center;
    gap: clamp(2.5rem, 4vw, 3.5rem);
    max-width: var(--landing-max-w);
    margin: 0 auto;
    padding: clamp(3.25rem, 5vw, 4.5rem) 1.5rem 4.5rem;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-figure {
    margin: 0;
    width: 100%;
  }

  .hero-print {
    background: #ffffff;
    border: 1px solid var(--editorial-rule);
    padding: 10px;
  }

  .hero-print canvas {
    display: block;
    width: 100%;
    height: 230px;
  }

  .hero-figure figcaption {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--text-subtle);
  }

  .hero-title {
    max-width: none;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(2rem, 3.1vw, 3.25rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-lede {
    margin-top: 1.25rem;
    max-width: 38rem;
