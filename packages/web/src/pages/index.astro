  <script>
    import { mountDitherScene } from "../lib/dither-scene";

    const printCanvas = document.querySelector<HTMLCanvasElement>("[data-print]");
    if (printCanvas) {
      mountDitherScene(printCanvas, {
        horizonPx: 124,
        skyMax: 0.34,
        sun: false,
        frost: 1,
        animate: false,
      });
    }

    const copyInstallButton = document.querySelector("[data-copy-install]");
    const installCommand = document.querySelector("[data-install-command]");

    copyInstallButton?.addEventListener("click", async () => {
      const text = installCommand?.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      copyInstallButton.setAttribute("data-copied", "true");
      window.setTimeout(() => {
        copyInstallButton.removeAttribute("data-copied");
      }, 1600);
    });

    const harnessTabList = document.querySelector("[data-harness-tabs]");
    let activateHarness = (_key: string, _focus = false) => {};
    if (harnessTabList) {
      const tabs = Array.from(
        harnessTabList.querySelectorAll<HTMLElement>('[role="tab"]'),
      );

      activateHarness = (key: string, focus = false) => {
        const tab = tabs.find((item) => item.dataset.key === key);
        if (!tab) return;
        for (const item of tabs) {
          const selected = item === tab;
          item.setAttribute("aria-selected", selected ? "true" : "false");
          item.tabIndex = selected ? 0 : -1;
          const panelId = item.getAttribute("aria-controls");
          const panel = panelId ? document.getElementById(panelId) : null;
          if (panel) panel.hidden = !selected;
        }
        if (focus) tab.focus();
      };

      harnessTabList.addEventListener("click", (event) => {
        const tab = (event.target as HTMLElement).closest<HTMLElement>('[role="tab"]');
        if (tab?.dataset.key) activateHarness(tab.dataset.key);
      });

      harnessTabList.addEventListener("keydown", (event) => {
        const current = document.activeElement as HTMLElement | null;
        if (!current || !tabs.includes(current)) return;
        const key = (event as KeyboardEvent).key;
        const index = tabs.indexOf(current);
        let next: number | null = null;
        if (key === "ArrowDown" || key === "ArrowRight") {
          next = (index + 1) % tabs.length;
        } else if (key === "ArrowUp" || key === "ArrowLeft") {
          next = (index - 1 + tabs.length) % tabs.length;
        } else if (key === "Home") {
          next = 0;
        } else if (key === "End") {
          next = tabs.length - 1;
        }
        if (next === null) return;
        event.preventDefault();
        activateHarness(tabs[next]!.dataset.key ?? "", true);
      });

    }

    const equation = document.querySelector("[data-equation]");
    if (equation) {
      const setAll = (selector: string, text: string) => {
        for (const el of document.querySelectorAll(selector)) {
          el.textContent = text;
        }
      };

      equation.addEventListener("click", (event) => {
        const chip = (event.target as HTMLElement).closest<HTMLElement>(".harness-chip");
        if (!chip) return;
        const agent = chip.dataset.eqAgent;
        const iface = chip.dataset.eqInterface;
        if (agent) {
          for (const c of equation.querySelectorAll("[data-eq-agent]")) {
            c.setAttribute("aria-pressed", c === chip ? "true" : "false");
          }
          setAll("[data-eq-agent-name]", chip.dataset.name ?? agent);
          for (const badge of document.querySelectorAll<HTMLElement>("[data-factory-agent]")) {
            badge.hidden = badge.dataset.factoryAgent !== agent;
          }
          activateHarness(agent);
        } else if (iface) {
          for (const c of equation.querySelectorAll("[data-eq-interface]")) {
            c.setAttribute("aria-pressed", c === chip ? "true" : "false");
          }
          setAll("[data-eq-iface-name]", iface);
        }
      });
    }
  </script>
