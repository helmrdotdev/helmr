---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pixelsFromRows } from "../lib/pixels";
import { breadcrumbJsonLd, softwareJsonLd } from "../lib/seo";

const runtimeFile = (imports: string, agent: string) => `import { image, sandbox, source, task, tokens } from "@helmr/sdk"
${imports}
import { z } from "zod"

const base = image("repo-agent")
  .from("node:24-bookworm-slim")
  .workdir("/workspace")
  .run(["sh", "-ceu", "apt-get update && apt-get install -y git ripgrep"])
  .copy("/workspace/package.json", source.file("package.json"))
  .run(["bun", "install"])

export const repoSandbox = sandbox({ id: "repo-agent" })
  .image(base)
  .resources({ cpu: 2, memory: "4GiB" })

export const reviewPr = task({
  id: "review-pr",
  payload: z.object({ prNumber: z.number().int().positive() }),
  run: async (event, ctx) => {
${agent}

    const approval = await tokens.create({ timeout: "30m" })
    await sendSlackApproval({
      callbackUrl: approval.callbackUrl
    })
    // The microVM freezes here — filesystem, memory, process.
    const decision = await approval.wait({
      schema: z.object({ approved: z.boolean() }),
      timeout: "30m",
      tags: ["approval", "github-review"],
      metadata: { subject: "Post this review to GitHub?" }
    }).unwrap()
    if (decision.approved) await postReview(event.prNumber, review)
  }
})`;

const harnesses = [
  {
    key: "claude",
    name: "Claude Agent SDK",
    meta: "@anthropic-ai/claude-agent-sdk",
    icon: "/icons/claude.svg",
    imports: 'import { query } from "@anthropic-ai/claude-agent-sdk"',
    agent: `    let review = ""
    for await (const message of query({
      prompt: \`Review PR #\${event.prNumber} and propose a patch.\`,
      options: {
        cwd: "/workspace",
        permissionMode: "bypassPermissions", // the microVM is the sandbox
        allowDangerouslySkipPermissions: true
      }
    })) {
      if (message.type === "result" && message.subtype === "success") review = message.result
    }`,
  },
  {
    key: "codex",
    name: "Codex",
    meta: "@openai/codex-sdk",
    icon: "/icons/openai.svg",
    imports: 'import { Codex } from "@openai/codex-sdk"',
    agent: `    const codex = new Codex()
    const thread = codex.startThread({
      workingDirectory: "/workspace",
      sandboxMode: "danger-full-access" // the microVM is the sandbox
    })
    const turn = await thread.run(\`Review PR #\${event.prNumber} and propose a patch.\`)
    const review = turn.finalResponse`,
  },
  {
    key: "cursor",
    name: "Cursor",
    meta: "@cursor/sdk",
    icon: "/icons/cursor.svg",
    imports: 'import { Agent } from "@cursor/sdk"',
    agent: `    const result = await Agent.prompt(\`Review PR #\${event.prNumber} and propose a patch.\`, {
      apiKey: process.env.CURSOR_API_KEY!, // protected env: the VM only holds a placeholder
      model: { id: "composer-2.5" },
      local: { cwd: "/workspace" }
    })
    const review = result.result ?? ""`,
  },
  {
    key: "opencode",
    name: "OpenCode",
    meta: "@opencode-ai/sdk · opencode serve",
    icon: "/icons/opencode.svg",
    imports: 'import { createOpencode } from "@opencode-ai/sdk"',
    agent: `    const { client } = await createOpencode()
    const session = await client.session.create({ body: { title: \`pr-\${event.prNumber}\` } })
    const result = await client.session.prompt({
      path: { id: session.data.id },
      body: {
        model: { providerID: "openrouter", modelID: "z-ai/glm-4.6" },
        parts: [{ type: "text", text: \`Review PR #\${event.prNumber} and propose a patch.\` }]
      }
    })
    const review = result.data.parts
      .filter((part) => part.type === "text")
      .map((part) => part.text)
      .join("")`,
  },
  {
    key: "pi",
    name: "Pi",
    meta: "@earendil-works/pi-coding-agent",
    icon: "/icons/pi.svg",
    imports: 'import { createAgentSession, SessionManager } from "@earendil-works/pi-coding-agent"',
    agent: `    const { session } = await createAgentSession({
      cwd: "/workspace",
      sessionManager: SessionManager.inMemory()
    })
    let review = ""
    session.subscribe((e) => {
      if (e.type === "message_update" && e.assistantMessageEvent.type === "text_delta") {
        review += e.assistantMessageEvent.delta
      }
    })
    await session.prompt(\`Review PR #\${event.prNumber} and propose a patch.\`)`,
  },
  {
    key: "own",
    name: "Your own harness",
    meta: "ai · @ai-sdk/amazon-bedrock",
    icon: null,
    imports: `import { generateText, tool, stepCountIs } from "ai"
import { bedrock } from "@ai-sdk/amazon-bedrock"`,
    agent: `    const { text: review } = await generateText({
      model: bedrock("anthropic.claude-sonnet-4-6"), // or Vertex, Ollama — any provider the AI SDK speaks
      tools: {
        sh: tool({
          description: "Run a shell command in /workspace",
          inputSchema: z.object({ cmd: z.string() }),
          execute: ({ cmd }) => sh(cmd)
        })
      },
      stopWhen: stepCountIs(40),
      prompt: \`Review PR #\${event.prNumber} and propose a patch.\`
    })`,
  },
] as const;

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const syntaxKeywords = ["import", "from", "export", "const", "new", "async", "await", "if", "as", "for", "of", "let", "return"] as const;
const syntaxLiterals = ["true", "false", "null", "undefined"] as const;
const syntaxReserved = new Set<string>([...syntaxKeywords, ...syntaxLiterals]);
const syntaxReservedPattern = [...syntaxKeywords, ...syntaxLiterals].join("|");

const highlightTypeScript = (value: string) => {
  const tokenPattern = new RegExp(
    `("(?:\\\\.|[^"\\\\])*"|'(?:\\\\.|[^'\\\\])*'|\\/\\/.*|\\b(?:${syntaxReservedPattern})\\b|\\b\\d+\\b|\\.[A-Za-z_$][\\w$]*|\\b[A-Za-z_$][\\w$]*(?=\\()|[{}()[\\].,:])`,
    "g",
  );
  let cursor = 0;
  let html = "";

  for (const match of value.matchAll(tokenPattern)) {
    const token = match[0];
    const index = match.index ?? 0;
    html += escapeHtml(value.slice(cursor, index));

    let tokenClass = "tok-punct";
    if (token.startsWith('"') || token.startsWith("'")) tokenClass = "tok-string";
    else if (token.startsWith("//")) tokenClass = "tok-comment";
    else if (/^\d+$/.test(token)) tokenClass = "tok-number";
    else if (token.startsWith(".")) tokenClass = "tok-property";
    else if (syntaxReserved.has(token)) {
      tokenClass = "tok-keyword";
    } else if (/^[A-Za-z_$]/.test(token)) {
      tokenClass = "tok-call";
    }

    html += `<span class="${tokenClass}">${escapeHtml(token)}</span>`;
    cursor = index + token.length;
  }

  return html + escapeHtml(value.slice(cursor));
};

const runtimeLine = (lines: string[], anchor: string) => {
  const matches = lines.flatMap((line, index) =>
    line === anchor ? [index + 1] : [],
  );
  if (matches.length !== 1) {
    throw new Error(`Runtime code anchor must match exactly once: ${anchor}`);
  }
  return matches[0]!;
};

const runtimeRegion = (lines: string[], start: string, end: string) => {
  const from = runtimeLine(lines, start);
  const to = runtimeLine(lines, end);
  if (from > to) throw new Error(`Runtime code region is inverted: ${start}`);
  return { from, to };
};

const tints: Record<string, string> = {
  yellow: "#f5eeda",
  blue: "#e7eef7",
  pink: "#f3e8ee",
  green: "#eaf0e6",
};

const runtimeVariants = harnesses.map((harness) => {
  const lines = runtimeFile(harness.imports, harness.agent).split("\n");
  const approvalLine = runtimeLine(
    lines,
    '    const approval = await tokens.create({ timeout: "30m" })',
  );
  const regions = [
    {
      key: "image",
      label: "image",
      ...runtimeRegion(lines, 'const base = image("repo-agent")', '  .run(["bun", "install"])'),
      tone: "blue",
      strong: "#5079e4",
    },
    {
      key: "sandbox",
      label: "sandbox",
      ...runtimeRegion(
        lines,
        'export const repoSandbox = sandbox({ id: "repo-agent" })',
        '  .resources({ cpu: 2, memory: "4GiB" })',
      ),
      tone: "green",
      strong: "#5e8a70",
    },
    {
      key: "task",
      label: "task",
      from: runtimeLine(lines, "export const reviewPr = task({"),
      to: approvalLine - 2,
      tone: "pink",
      strong: "#a8618a",
    },
    {
      key: "input",
      label: "human input",
      from: approvalLine,
      to: runtimeLine(
        lines,
        "    if (decision.approved) await postReview(event.prNumber, review)",
      ),
      tone: "yellow",
      strong: "#ad8226",
    },
  ];
  return {
    ...harness,
    codeLines: lines.map((line, index) => ({
      html: highlightTypeScript(line) || "&nbsp;",
      region: regions.find((region) => index + 1 >= region.from && index + 1 <= region.to)?.key,
    })),
    codeTags: regions.map((region) => ({
      key: region.key,
      label: region.label,
      line: region.from,
      tone: region.tone,
      strong: region.strong,
    })),
  };
});

const highlightShell = (value: string) =>
  value
    .split("\n")
    .map((line) =>
      line.startsWith("$ ")
        ? `<span class="tok-prompt">$</span> ${escapeHtml(line.slice(2))}`
        : `<span class="tok-comment">${escapeHtml(line)}</span>`,
    )
    .join("\n");

