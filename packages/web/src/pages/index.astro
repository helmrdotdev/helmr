  /*
   * Rail | reading column with equal gutters | margin. The reading column, not
   * the whole frame, is centered on the page; the unruled margin column on the
   * right carries code annotations.
   */
  .frame {
    --main: calc(var(--gutter) + var(--col) + var(--pad));
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, var(--main)) var(--rail);
    width: calc(2 * var(--rail) + var(--main));
    max-width: calc(100% - 2 * var(--edge));
    margin-left: max(var(--edge), calc(50% - var(--rail) - var(--gutter) - var(--col) / 2));
    border-left: 1px solid var(--line);
  }




  /* ---- left rail ---- */
  .rail {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100vh;
    padding: calc(var(--top) - 2.25rem) 1.5rem 2rem 0;
  }

  /* the same mark-to-name proportions as the site header, set a little smaller */
  .rail-brand,
  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    width: fit-content;
    font-family: var(--font-brand);
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.025em;
    color: var(--ink-1);
  }

  .rail > * { padding-left: 1.25rem; }
  .rail > .rail-cta { margin-left: 1.25rem; padding-left: 0.6rem; }

  .rail-brand :global(.brand-mark),
  .foot-brand :global(.brand-mark) {
    width: 1.5em;
    height: auto;
  }

  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.75rem;
  }

  .rail-nav a {
    position: relative;
    width: fit-content;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-1);
  }

  .rail-nav a:hover { color: var(--link); }
  .rail-nav a[aria-current="page"] { color: var(--link); }
  .rail-nav a[aria-current="page"]::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -1.25rem;
    width: 0.6rem;
    height: 1px;
    background: var(--link);
  }

  .rail-cta {
    width: fit-content;
    padding: 0.3rem 0.6rem;
    border: 1px solid transparent;
    border-image: var(--frame) 8 / 8px stretch;
    font-size: 0.8125rem;
    color: var(--ink-1);
  }

  .rail-cta:hover { border-image: var(--frame-solid) 8 fill / 8px stretch; color: var(--paper); }


  /* ---- main band ---- */
  .column {
    grid-column: 2;
    min-width: 0;
    padding: var(--top) var(--pad) 3rem var(--gutter);
    border-inline: 1px solid var(--line);
  }

  .block {
    padding: 4rem 0;
  }

  .hero { padding-top: 0; }


  /* ---- type ---- */

  h1,
  h2 {
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--ink-1);
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.125rem, 3.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.375rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .lede {
    margin-top: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  .block > p:not(.lede, .note) {
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-1);
  }

  .lede + p { margin-top: 1rem; }

  .block p code,
  .note code {
    padding: 0 0.25em;
    background: #ece9e3;
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .note {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--ink-3);
  }

  .note a,
  .card-head a { color: var(--link); }

  .note a:hover,
  .card-head a:hover { text-decoration: underline; }

  /* ---- buttons ---- */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* buttons and boxes keep crisp text inside hand-drawn outlines */
  .button {
    padding: 0.45rem 0.85rem;
    border: 1px solid transparent;
    border-image: var(--frame) 8 / 8px stretch;
    font-size: 0.875rem;
    color: var(--ink-1);
    transition: opacity 0.12s;
  }

  .button:hover { border-image: var(--frame-hover) 8 fill / 8px stretch; }
  .button-dark { border-image: var(--frame-solid) 8 fill / 8px stretch; color: var(--paper); }
  .button-dark:hover { border-image-source: var(--frame-solid); opacity: 0.88; }

  .hand-underline { position: relative; white-space: nowrap; }
  .hand-underline::after {
    content: "";
    position: absolute;
    left: -0.06em;
    right: -0.04em;
    bottom: -0.16em;
    height: 0.3em;
    background: url("/illustrations/underline.svg") 0 0 / 100% 100% no-repeat;
  }

  .install {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: min(100%, 25rem);
    margin-top: 1rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-image: var(--frame-light) 8 / 8px stretch;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    text-align: left;
    cursor: pointer;
  }

  .install:hover,
  .install:focus-visible { border-image-source: var(--frame); outline: 0; }
  .install code { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: inherit; }
  .install-prompt, .install-state { color: var(--ink-3); }

  /* ---- hero scene ---- */
  /* the drawing's peak and sky rise beside the buttons; the copy stays on top */
  .hero { z-index: 1; }
  .scene { margin: -6rem 0 0; }

  @media (min-width: 84rem) {
    .scene { margin-top: -9.5rem; }
  }

  .scene img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* the ground runs out to the column's edges, so the drawing stands on the page */
  .ground {
    height: 12px;
    margin: -0.25rem calc(-1 * var(--pad)) 0 calc(-1 * var(--gutter));
    background: url("/illustrations/ground.svg") 0 0 / 100% 100% no-repeat;
  }


  /* ---- logo grid ---- */
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 2rem;
    list-style: none;
    background: var(--hand-rule) top / 100% 4px no-repeat, var(--hand-rule-v) left / 4px 100% no-repeat;
  }

  .logo-grid li {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 6.5rem;
    background: var(--hand-rule-v) right / 4px 100% no-repeat, var(--hand-rule) bottom / 100% 4px no-repeat;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .logo-grid img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
  }



  /* ---- cards ---- */
  .card {
    margin-top: 2rem;
    border: 1px solid transparent;
    border-image: var(--hand-card) 8 fill / 8px stretch;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    background: var(--hand-rule) bottom / 100% 4px no-repeat;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-1);
  }

  .card-head > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .muted { color: var(--ink-3); }
  .ok { color: #3c7a51; }

  /* code */
  .code {
    margin: 0;
    padding: 1rem 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: #2c2c33;
  }

  .code code { display: block; min-width: max-content; font: inherit; }
  .line { display: block; padding-right: 0.75rem; white-space: pre; }

  .ln {
    display: inline-block;
    width: 2.6rem;
    padding-right: 1rem;
    text-align: right;
    color: #bdb9b1;
    user-select: none;
  }

  .code :global(.tok-keyword) { color: #2b4fd8; }
  .code :global(.tok-string) { color: #3c7a51; }
  .code :global(.tok-number) { color: #a66d12; }
  .code :global(.tok-call) { color: #b0457c; }
  .code :global(.tok-property) { color: #2f7a99; }
  .code :global(.tok-punct) { color: #97939b; }
  .code :global(.tok-comment) { color: #a7a299; font-style: italic; }


  /* hub: teammates and agents around one Slack channel, drawn as a dial */
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
    margin: 2.5rem 0 0;
  }

  .dial { display: block; width: 100%; height: auto; overflow: visible; }

  .tick { stroke: var(--rule-strong); stroke-width: 1; }
  .spoke { stroke: var(--rule-strong); stroke-width: 1; transition: stroke 0.15s; }

  .hand { color: var(--link); }
  .hand path { fill: none; stroke: currentColor; stroke-width: 1.25; }

  .core { fill: #fff; stroke: var(--ink-1); stroke-width: 1; }
  .core-label { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-2); }

  .node .tile { fill: #fff; stroke: var(--ink-1); stroke-width: 1; transition: stroke 0.15s; }
  .node .person circle,
  .node .person path { fill: none; stroke: var(--ink-1); stroke-width: 1.1; stroke-linecap: round; }
  .node-name { font-family: var(--font-sans); font-size: 14px; fill: var(--ink-1); }
  .node-role { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-3); }

  .hub[data-active] .node .tile { stroke: var(--rule-strong); }
  .hub[data-active] .node.is-active .tile { stroke: var(--link); stroke-width: 1.5; }
  .hub[data-active] .spoke.is-active { stroke: var(--link); }

  .cast-list {
    list-style: none;
    background: var(--hand-rule-faint) top / 100% 5px no-repeat;
  }

  .cast-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0;
    background: var(--hand-rule-faint) bottom / 100% 5px no-repeat;
    cursor: default;
  }

  .cast-face {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: #fff;
  }

  .cast-face img { width: 1.75rem; height: 1.75rem; }
  .cast-face svg { width: 1rem; height: 1rem; fill: none; stroke: var(--ink-1); stroke-width: 1.4; stroke-linecap: round; }

  .cast-who {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-1);
  }

  .cast-who span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .cast-did {
    margin-top: 0.15rem;
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .cast-list li.is-active .cast-who { color: var(--link); }

  /* carry: the same machine state, saved outside and continued elsewhere */
  .carry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem minmax(0, 1fr) 4.5rem minmax(0, 1fr);
    align-items: stretch;
    margin: 2rem 0 0;
  }

  .machine {
    display: flex;
    flex-direction: column;
    border: 1px solid transparent;
    border-image: var(--hand-machine) 8 fill / 8px stretch;
  }

  .machine.is-saved { border-image: var(--hand-saved) 8 / 8px round; }

  .machine-h {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: var(--hand-rule) bottom / 100% 4px no-repeat;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .is-saved .machine-h { background: var(--hand-rule-dashed) bottom / 26px 8px repeat-x; color: var(--ink-2); }

  .ts {
    padding: 0.05rem 0.3rem;
    background: #2f74c0;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 500;
  }

  .machine-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem;
  }

  .part-h {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-3);
  }

  .part-h:first-child { margin-top: 0; }

  .mem {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 3px;
  }

  .mem i {
    aspect-ratio: 1;
    border: 1px solid var(--rule-strong);
  }

  .mem i.on { background: #b9c8f5; border-color: #7b95e6; }

  .procs {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .procs i {
    height: 6px;
    background: var(--ink-1);
  }

  .files {
    display: flex;
    gap: 6px;
  }

  .files i {
    width: 18px;
    height: 22px;
    border: 1px solid var(--ink-1);
    background: linear-gradient(225deg, var(--paper) 5px, transparent 5px);
  }

  /* the saved copy is the same state, drawn as an outline */
  .is-saved .mem i.on { background: transparent; border-color: #7b95e6; border-style: dashed; }
  .is-saved .procs i { background: transparent; border: 1px dashed var(--ink-2); height: 6px; }
  .is-saved .files i { border-style: dashed; border-color: var(--ink-2); }

  .machine-note {
    margin-top: auto;
    padding: 0.6rem 0.9rem;
    background: var(--hand-rule) top / 100% 4px no-repeat;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .is-saved .machine-note { background: var(--hand-rule-dashed) top / 26px 8px repeat-x; }

  .carry-arrow {
    position: relative;
    align-self: center;
    display: flex;
    justify-content: center;
    height: 1px;
    margin: 0 0.4rem;
    background-image: linear-gradient(90deg, var(--ink-1) 3px, transparent 3px);
    background-size: 6px 1px;
  }
  .carry-arrow::after {
    content: "";
    position: absolute;
    top: -3.5px;
    right: -1px;
    border-block: 4px solid transparent;
    border-left: 7px solid var(--ink-1);
  }

  .carry-arrow span {
    position: absolute;
    bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-2);
  }



  /* docs links: inline under the lead on narrow screens, in the margin on wide ones */
  .block { position: relative; }

  .side-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--link);
  }

  .side-link span { color: var(--ink-3); }
  .side-link:hover { text-decoration: underline; }

  @media (min-width: 84rem) {
    .side-link {
      position: absolute;
      top: calc(4rem + 0.35rem);
      left: calc(100% + var(--pad) + 1.25rem);
      flex-direction: column;
      gap: 0.15rem;
      width: calc(var(--rail) - 2.25rem);
      margin: 0;
    }
  }


  /* annotations */
  .annotated { position: relative; }
  .annotated .card { margin-top: 2rem; }

  /* the band's place is fixed, inset to stay inside the card's hand-drawn outline; hover only fills it */
  .is-noted { background: 5px 0 / calc(100% - 10px) 100% no-repeat; }
  .annotated[data-active] .is-noted.is-active { background-image: linear-gradient(var(--accent-wash), var(--accent-wash)); }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .notes li {
    position: relative;
    font-size: 0.8125rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--rule-strong);
    cursor: default;
  }

  .notes li.is-active { border-left-color: var(--link); }

  .notes p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .notes .note-title {
    margin-bottom: 0.15rem;
    font-weight: 500;
    color: var(--ink-1);
  }

  /* Margin notes sit beside the line they describe. */
  @media (min-width: 84rem) {
    .notes {
      position: absolute;
      top: 0;
      left: calc(100% + var(--pad) + 1.25rem);
      display: block;
      width: calc(var(--rail) - 1.75rem);
      margin: 0;
    }

    .notes li { position: absolute; left: 0; right: 0; }

    /* a bracket beside the card spans the note's lines; the leader runs from it to the title */
    .notes li { --leader: var(--rule-strong); }
    .notes li.is-active { --leader: var(--link); }

    .notes li::before,
    .notes li::after {
      content: "";
      position: absolute;
    }

    .notes li::before {
      top: var(--leader-y, 0.75em);
      left: calc(-1 * (var(--pad) + 1.25rem) + 0.65rem);
      width: calc(var(--pad) + 0.2rem);
      height: 1px;
      background: linear-gradient(var(--leader), var(--leader));
    }

    .notes li::after {
      top: var(--bar-top, 0.75em);
      left: calc(-1 * (var(--pad) + 1.25rem) + 0.25rem);
      width: 0.4rem;
      height: var(--bar-height, 1px);
      background:
        linear-gradient(var(--leader), var(--leader)) right top / 1px 100% no-repeat,
        linear-gradient(var(--leader), var(--leader)) left var(--tick-top, 0) / 100% 1px no-repeat,
        linear-gradient(var(--leader), var(--leader)) left var(--tick-bottom, 0) / 100% 1px no-repeat;
    }
  }

  /* high-contrast mode drops gradients: draw the bracket and leader with borders */
  @media (forced-colors: active) and (min-width: 84rem) {
    .notes li::before { background: none; border-top: 1px solid CanvasText; }
    .notes li::after { background: none; border: 1px solid CanvasText; border-left: 0; }
  }

  /* secrets */
  /* private network: inside the network, the proxy, and where traffic may go */
  .net { margin: 2.5rem 0 0; }

  /* your team enters from the company network, above the figure */
  .net-team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 0.75rem;
    padding: 0 1rem;
  }

  .net-chip {
    justify-self: start;
    margin-top: 0;
    padding: 0.35rem 0.7rem;
    font-size: 0.8125rem;
    color: var(--ink-1);
  }

  .net-in {
    grid-column: 1;
    position: relative;
    height: 2.75rem;
    padding: 0.7rem 0 0 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-2);
  }

  .net-in::before {
    content: "";
    position: absolute;
    top: 0.2rem;
    bottom: 0.6rem;
    left: 0.75rem;
    width: 1px;
    background-image: linear-gradient(180deg, var(--ink-2) 3px, transparent 3px);
    background-size: 1px 7px;
  }

  .net-in::after {
    content: "";
    position: absolute;
    bottom: 0.2rem;
    left: calc(0.75rem - 4px);
    border: 4px solid transparent;
    border-top: 6px solid var(--ink-2);
  }

  .net-inside {
    position: relative;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid transparent;
    border-image: var(--hand-saved) 16 / 12px round;
  }

  .net-label {
    margin: 0 0 0.75rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-1);
  }

  .net-nodes,
  .net-out {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .net-out { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .net-node,
  .net-dest {
    display: flex;
    margin-top: 0;
    padding: 0.7rem 0.8rem;
    font-size: 0.8125rem;
    color: var(--ink-1);
  }

  .net-node { flex-direction: column; gap: 0.2rem; }
  .net-dest { align-items: center; gap: 0.7rem; }
  .net-dest > span { display: flex; flex-direction: column; gap: 0.1rem; }
  .net-dest img { width: 1.25rem; height: 1.25rem; flex: none; }

  .net-node .muted,
  .net-dest .muted { font-family: var(--font-mono); font-size: 0.65rem; }

  /* the proxy: one dashed rule across the figure, like the secrets boundary */
  .net-gate {
    position: relative;
    display: flex;
    align-items: center;
    height: 3rem;
  }

  .net-gate::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background-image: linear-gradient(90deg, var(--ink-2) 3px, transparent 3px);
    background-size: 7px 1px;
  }

  .net-gate span {
    position: relative;
    padding-right: 0.6rem;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
  }

  .net-dest-name { font-weight: 500; }

  /* sits on the frame's top edge, clear of the label beneath it */
