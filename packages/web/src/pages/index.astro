const shieldPixels = pixelsFromRows(pixelIcons.shield);

const taskFeatures = [
  {
    label: "task()",
    icon: "shield",
    tone: "green",
    title: "Write the Task",
    caption:
      "One exported const with a typed payload and a run function. That is the whole unit Helmr deploys.",
    code: `export const reviewPr = task({
  id: "review-pr",
  payload: z.object({ prNumber: z.number() }),
  run: async ({ prNumber }) => {
    return draftReview(prNumber)
  }
})`,
    lang: "ts",
  },
  {
    label: "client.tasks.start()",
    icon: "bolt",
    tone: "pink",
    title: "Start it from anywhere",
    caption: "Your product, a webhook, or CI starts a deployed Task with a typed payload against an existing Workspace.",
    code: `const run = await client.tasks.start<typeof reviewPr>(
  "review-pr",
  {
    payload: { prNumber: 482 },
    workspace
  }
)`,
    lang: "ts",
  },
  {
    label: "schedules.task()",
    icon: "clock",
    tone: "blue",
