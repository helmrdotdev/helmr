---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pixelsFromRows } from "../lib/pixels";
import { breadcrumbJsonLd, softwareJsonLd } from "../lib/seo";

const runtimeCode = `import { image, sandbox, source, task, tokens } from "@helmr/sdk"
import { Codex } from "@openai/codex-sdk"
import { z } from "zod"

const base = image("repo-agent")
  .from("node:24-bookworm-slim")
  .workdir("/workspace")
  .run(["sh", "-ceu", "apt-get update && apt-get install -y git ripgrep"])
  .copy("/workspace/package.json", source.file("package.json"))
  .run(["bun", "install"])

export const repoSandbox = sandbox({ id: "repo-agent" })
  .image(base)
  .resources({ cpu: 2, memory: "4GiB" })

export const reviewPr = task({
  id: "review-pr",
  payload: z.object({ prNumber: z.number().int().positive() }),
  run: async (event, ctx) => {
    const codex = new Codex()
    const thread = codex.startThread({ workingDirectory: process.cwd() })
    const turn = await thread.run("Review this PR and propose a patch.")

    const approval = await tokens.create({ timeout: "30m" })
    await sendSlackApproval({
      callbackUrl: approval.callbackUrl
    })
    // The microVM freezes here — filesystem, memory, process.
    const decision = await approval.wait({
      schema: z.object({ approved: z.boolean() }),
      timeout: "30m",
      tags: ["approval", "github-review"],
      metadata: { subject: "Post this review to GitHub?" }
    }).unwrap()
    if (decision.approved) await postReview(event.prNumber, turn.finalResponse)
  }
})`;

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const syntaxKeywords = ["import", "from", "export", "const", "new", "async", "await", "if", "as"] as const;
const syntaxLiterals = ["true", "false", "null", "undefined"] as const;
const syntaxReserved = new Set<string>([...syntaxKeywords, ...syntaxLiterals]);
const syntaxReservedPattern = [...syntaxKeywords, ...syntaxLiterals].join("|");

const highlightTypeScript = (value: string) => {
  const tokenPattern = new RegExp(
    `("(?:\\\\.|[^"\\\\])*"|'(?:\\\\.|[^'\\\\])*'|\\/\\/.*|\\b(?:${syntaxReservedPattern})\\b|\\b\\d+\\b|\\.[A-Za-z_$][\\w$]*|\\b[A-Za-z_$][\\w$]*(?=\\()|[{}()[\\].,:])`,
    "g",
  );
  let cursor = 0;
  let html = "";

  for (const match of value.matchAll(tokenPattern)) {
    const token = match[0];
    const index = match.index ?? 0;
    html += escapeHtml(value.slice(cursor, index));

    let tokenClass = "tok-punct";
    if (token.startsWith('"') || token.startsWith("'")) tokenClass = "tok-string";
    else if (token.startsWith("//")) tokenClass = "tok-comment";
    else if (/^\d+$/.test(token)) tokenClass = "tok-number";
    else if (token.startsWith(".")) tokenClass = "tok-property";
    else if (syntaxReserved.has(token)) {
      tokenClass = "tok-keyword";
    } else if (/^[A-Za-z_$]/.test(token)) {
      tokenClass = "tok-call";
    }

    html += `<span class="${tokenClass}">${escapeHtml(token)}</span>`;
    cursor = index + token.length;
  }

  return html + escapeHtml(value.slice(cursor));
};

const runtimeLines = runtimeCode.split("\n");

const runtimeLine = (anchor: string) => {
  const matches = runtimeLines.flatMap((line, index) =>
    line === anchor ? [index + 1] : [],
  );
  if (matches.length !== 1) {
    throw new Error(`Runtime code anchor must match exactly once: ${anchor}`);
  }
  return matches[0]!;
};

const runtimeRegion = (start: string, end: string) => {
  const from = runtimeLine(start);
  const to = runtimeLine(end);
  if (from > to) throw new Error(`Runtime code region is inverted: ${start}`);
  return { from, to };
};

const codeRegions = [
  {
    key: "image",
    label: "image",
    ...runtimeRegion('const base = image("repo-agent")', '  .run(["bun", "install"])'),
    tone: "blue",
    strong: "#5079e4",
  },
  {
    key: "sandbox",
    label: "sandbox",
    ...runtimeRegion(
      'export const repoSandbox = sandbox({ id: "repo-agent" })',
      '  .resources({ cpu: 2, memory: "4GiB" })',
    ),
    tone: "green",
    strong: "#5e8a70",
  },
  {
    key: "task",
    label: "task",
    ...runtimeRegion(
      "export const reviewPr = task({",
      '    const turn = await thread.run("Review this PR and propose a patch.")',
    ),
    tone: "pink",
    strong: "#a8618a",
  },
  {
    key: "input",
    label: "human input",
    ...runtimeRegion(
      '    const approval = await tokens.create({ timeout: "30m" })',
      "    if (decision.approved) await postReview(event.prNumber, turn.finalResponse)",
    ),
    tone: "yellow",
    strong: "#ad8226",
  },
] as const;

const tints: Record<string, string> = {
  yellow: "#f5eeda",
  blue: "#e7eef7",
  pink: "#f3e8ee",
  green: "#eaf0e6",
};

const codeLines = runtimeLines.map((line, index) => ({
  html: highlightTypeScript(line) || "&nbsp;",
  region: codeRegions.find((region) => index + 1 >= region.from && index + 1 <= region.to)?.key,
}));

const highlightShell = (value: string) =>
  value
    .split("\n")
    .map((line) =>
      line.startsWith("$ ")
        ? `<span class="tok-prompt">$</span> ${escapeHtml(line.slice(2))}`
        : `<span class="tok-comment">${escapeHtml(line)}</span>`,
    )
    .join("\n");

const pixelIcons = {
  pause: [
    "..........",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..##..##..",
    "..........",
  ],
  clock: [
    "...####...",
    "..#....#..",
    ".#..#...#.",
    "#...#....#",
    "#...#....#",
    "#...###..#",
    ".#......#.",
    "..#....#..",
    "...####...",
    "..........",
  ],
  bolt: [
    "..........",
    ".....##...",
    "....##....",
    "...##.....",
    "..######..",
    "....##....",
    "...##.....",
    "..##......",
    ".##.......",
    "..........",
  ],
  resume: [
    "...####...",
    "..#...###.",
    ".#....###.",
    "#......#..",
    "#.........",
    "#........#",
    ".#......#.",
    "..#....#..",
    "...####...",
    "..........",
  ],
  steer: [
    "..........",
    "......##..",
    ".########.",
    "......##..",
    "..........",
    "..##......",
    ".########.",
    "..##......",
    "..........",
    "..........",
  ],
  cloud: [
    "..........",
    "..........",
    "..##..##..",
    ".########.",
    "##########",
    "##########",
    ".########.",
    "..........",
    "..........",
    "..........",
  ],
  shield: [
    "..........",
    ".########.",
    ".#......#.",
    ".#..##..#.",
    ".#..##..#.",
    "..#....#..",
    "..#....#..",
    "...#..#...",
    "....##....",
    "..........",
  ],
  hourglass: [
    "..........",
    ".########.",
    ".#......#.",
    "..#.##.#..",
    "...####...",
    "...#..#...",
    "..#....#..",
    ".#..##..#.",
    ".########.",
    "..........",
  ],
} as const;

const cloudPixels = pixelsFromRows(pixelIcons.cloud);
const shieldPixels = pixelsFromRows(pixelIcons.shield);

const codeTags = codeRegions.map((region) => ({
  key: region.key,
  label: region.label,
  line: region.from,
  tone: region.tone,
  strong: region.strong,
}));

const taskFeatures = [
  {
    label: "task()",
    icon: "shield",
    tone: "green",
    title: "Write the Task",
    caption:
      "One exported const with a typed payload and a run function. That is the whole unit Helmr deploys.",
    code: `export const reviewPr = task({
  id: "review-pr",
  payload: z.object({ prNumber: z.number() }),
  run: async ({ prNumber }) => {
    return draftReview(prNumber)
  }
})`,
    lang: "ts",
  },
  {
    label: "client.tasks.start()",
    icon: "bolt",
    tone: "pink",
    title: "Start it from anywhere",
    caption: "Your product, a webhook, or CI starts a deployed Task with a typed payload against an existing Workspace.",
    code: `const run = await client.tasks.start<typeof reviewPr>(
  "review-pr",
  {
    payload: { prNumber: 482 },
    workspace
  }
)`,
    lang: "ts",
  },
  {
    label: "schedules.task()",
    icon: "clock",
    tone: "blue",
    title: "Put it on a cron",
    caption: "The schedule lives beside the code and ships with it. Every fire gets a fresh Workspace.",
    code: `export const nightly = schedules.task({
  id: "nightly-audit",
  cron: {
    pattern: "0 9 * * 1-5", timezone: "Asia/Tokyo"
  },
  workspace: { sandbox: repoSandbox },
  run: async (_, ctx) => runAudit(ctx)
})`,
    lang: "ts",
  },
  {
    label: "tokens.create()",
    icon: "pause",
    tone: "yellow",
    title: "Wait for a human",
    caption:
      "The microVM freezes whole while it waits — filesystem, memory, process. A scoped callback completes one value.",
    code: `const approval = await tokens.create({ timeout: "30m" })

const decision = await approval.wait({
  schema: z.object({ approved: z.boolean() }),
  timeout: "30m",
  tags: ["approval", "github-review"]
}).unwrap()`,
    lang: "ts",
  },
] as const;

const renderedTaskFeatures = taskFeatures.map((feature) => ({
  ...feature,
  html: feature.lang === "ts" ? highlightTypeScript(feature.code) : highlightShell(feature.code),
  pixels: pixelsFromRows(pixelIcons[feature.icon]),
}));

const workspaceFeatures = [
  {
    label: "image() + sandbox()",
    icon: "cloud",
    tone: "blue",
    title: "Define the environment",
    caption: "Choose the base image, install CLIs, and set the working directory and resources behind the Workspace.",
    code: `const base = image("repo-agent")
  .from("node:24-bookworm-slim")
  .workdir("/workspace")
  .run(["npm", "install", "-g", "@openai/codex"])

export const repoSandbox = sandbox({
  id: "repo-agent"
})
  .image(base)
  .resources({
    cpu: 2,
    memory: "4GiB"
  })`,
  },
  {
    label: "client.sandboxes.createWorkspace()",
    icon: "resume",
    tone: "green",
    title: "Create the Workspace",
    caption: "Create it once, run bounded commands, and attach later Task and Actor Runs to the same files.",
    code: `const workspace = await client.sandboxes.createWorkspace(
  "repo-agent",
  {
    key: \`github-pr:\${pr.id}\`,
    idempotencyKey: \`workspace:\${pr.id}\`
  }
)

const result = await workspace.exec({
  command: ["bash", "-lc", "bun test"],
  cwd: "/workspace",
  idempotencyKey: \`verify:\${pr.id}\`
})`,
  },
] as const;

const renderedWorkspaceFeatures = workspaceFeatures.map((feature) => ({
  ...feature,
  html: highlightTypeScript(feature.code),
  pixels: pixelsFromRows(pixelIcons[feature.icon]),
}));

const actorFeature = {
  title: "Steerable agent sessions.",
  caption:
    "Send a correction from Slack, your product, or the CLI. The Session history survives waits and continuation Runs.",
  define: `export const reviewer = actor({
  id: "reviewer",
  async run(session) {
    const input = await session.input
      .receive({ idleTimeout: "30m" })
      .unwrap()

    await session.output.append({
      type: "progress",
      message: "Reviewing",
      input
    })
  }
})`,
  send: `// From your product or webhook:
const session = client.sessions.ref(sessionId)

await session.input.send({
  type: "steer",
  instruction: "Please also update the tests."
}, { idempotencyKey: "slack:thread-1:message-7" })

const { records } = await session.output.list()

for (const record of records) {
  render(record.sequence, record.data)
}`,
};

const renderedActor = {
  ...actorFeature,
  defineHtml: highlightTypeScript(actorFeature.define),
  sendHtml: highlightTypeScript(actorFeature.send),
  definePixels: pixelsFromRows(pixelIcons.hourglass),
  sendPixels: pixelsFromRows(pixelIcons.steer),
};
---

<BaseLayout
  title="Helmr — The code-first runtime for AI agents"
  socialTitle="The code-first runtime for AI agents"
  description="The code-first runtime for AI agents. Define agent workloads in TypeScript and run them in isolated Linux microVMs with durable workspaces, scoped secrets, human or external waitpoints, logs, and run history."
  path="/"
  jsonLd={[softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}
>
  <div class="landing">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <h1 class="headline hero-title">
            The code-first runtime <span class="faint">for AI agents.</span>
          </h1>
          <p class="hero-lede">
            Define agent work in TypeScript. Run it in isolated Linux microVMs
            with durable workspaces and human input.
          </p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="/docs/quickstart">Start building</a>
            <a class="hero-link" href="https://github.com/helmrdotdev/helmr" target="_blank" rel="noopener">
              View on GitHub
              <svg class="hero-link-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M5 11L11 5M6 5H11V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </a>
          </div>
          <button class="install-command" type="button" data-copy-install aria-label="Copy install command">
            <code data-install-command>curl -fsSL https://helmr.dev/install | bash</code>
            <span class="copy-control" aria-hidden="true">
              <svg class="copy-icon" viewBox="0 0 24 24" fill="none">
                <path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none">
                <path d="M2.75 15.0938L9 20.25L21.25 3.75" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
              </svg>
            </span>
          </button>
        </div>
        <figure class="hero-figure" aria-hidden="true">
          <div class="hero-print">
            <canvas data-print></canvas>
          </div>
          <figcaption>fig. 01 &mdash; steady at the helm</figcaption>
        </figure>
      </div>
    </section>

    <section id="runtime" class="code-section" aria-label="Runtime definition">
      <div class="section-head">
        <h2 class="headline section-title">
          One TypeScript file.
          <span class="faint">Image, Sandbox, Task, human input.</span>
        </h2>
        <p class="section-note">
          Codex here &mdash; or Claude Code, the AI SDK, any agent SDK that runs on
          Node. Durable continuation uses Actor input or independently completable Tokens;
          one-shot Task input remains an explicit start payload.
        </p>
      </div>
      <div class="code-frame panel panel-screen">
        <div class="code-cap">
          <span>review-pr.ts</span>
          <span class="cap-meta">typescript</span>
        </div>
        <pre><code>{codeLines.map((line, i) => (
          <span class="cl" data-region={line.region}><span class="ln">{String(i + 1).padStart(2, " ")}</span><span class="lc" set:html={line.html}></span></span>
        ))}</code></pre>
        <div class="code-tags" aria-hidden="true">
          {codeTags.map((tag) => (
            <span
              class={`code-tag code-tag-${tag.key}`}
              style={`--line: ${tag.line}; --tag-strong: ${tag.strong}; background: ${tints[tag.tone]}`}
            >{tag.label}</span>
          ))}
        </div>
      </div>
      <nav class="proof-links" aria-label="Execution model sections">
        <a href="#primitives"><span>01</span> Task</a>
        <a href="#actor"><span>02</span> Actor</a>
        <a href="#workspace"><span>03</span> Workspace</a>
      </nav>
    </section>

    <section id="primitives" class="features" aria-label="Task patterns">
      <div class="section-head">
        <h2 class="headline section-title">
          Workflows as functions.{" "}
          <span class="faint">Typed in, typed out, durable in between.</span>
        </h2>
      </div>
      <div class="feature-grid">
        {renderedTaskFeatures.map((feature) => (
          <div class="feature">
            <div class="feature-head">
              <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints[feature.tone]}`}>
                {feature.pixels.map((pixel) => (
                  <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                ))}
              </svg>
              <h3 class="feature-title">{feature.title}</h3>
            </div>
            <div class="feature-panel panel panel-screen">
              <div class="code-cap">
                <span>{feature.label}</span>
                <span class="cap-meta">{feature.lang === "ts" ? "typescript" : "bash"}</span>
              </div>
              <pre><code set:html={feature.html}></code></pre>
            </div>
            <p class="feature-caption">{feature.caption}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="actor" class="actor-section" aria-label="Actor steering">
      <div class="section-head">
        <h2 class="headline section-title">
          {renderedActor.title}{" "}
          <span class="faint">Input and output, kept across Runs.</span>
        </h2>
      </div>
      <div class="pair-panels">
        <div class="paired-feature">
          <div class="feature-head">
            <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints.yellow}`}>
              {renderedActor.definePixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            <h3 class="feature-title">Define the Actor</h3>
          </div>
          <div class="feature-panel panel panel-screen">
            <div class="code-cap">
              <span>actor()</span>
              <span class="cap-meta">typescript</span>
            </div>
            <pre><code set:html={renderedActor.defineHtml}></code></pre>
          </div>
        </div>
        <div class="paired-feature">
          <div class="feature-head">
            <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints.blue}`}>
              {renderedActor.sendPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            <h3 class="feature-title">Send input and read output</h3>
          </div>
          <div class="feature-panel panel panel-screen">
            <div class="code-cap">
              <span>client.sessions.ref()</span>
              <span class="cap-meta">typescript</span>
            </div>
            <pre><code set:html={renderedActor.sendHtml}></code></pre>
          </div>
        </div>
      </div>
      <p class="feature-caption actor-caption">{renderedActor.caption}</p>
    </section>

    <section id="workspace" class="workspace-section" aria-label="Shared Workspace">
      <div class="section-head">
        <h2 class="headline section-title">
          Persistent VM filesystems.{" "}
          <span class="faint">The same /workspace, Run after Run.</span>
        </h2>
      </div>
      <div class="pair-panels workspace-panels">
        {renderedWorkspaceFeatures.map((feature) => (
          <div class="paired-feature workspace-feature">
            <div class="feature-head">
              <svg class="feature-icon" viewBox="0 0 10 10" aria-hidden="true" style={`background: ${tints[feature.tone]}`}>
                {feature.pixels.map((pixel) => (
                  <rect x={pixel.x} y={pixel.y} width="1" height="1" />
                ))}
              </svg>
              <h3 class="feature-title">{feature.title}</h3>
            </div>
            <div class="feature-panel panel panel-screen">
              <div class="code-cap">
                <span>{feature.label}</span>
                <span class="cap-meta">typescript</span>
              </div>
              <pre><code set:html={feature.html}></code></pre>
            </div>
            <p class="feature-caption">{feature.caption}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="homes" aria-label="Deployment options">
      <div class="section-head">
        <h2 class="headline section-title">
          Run on our cloud,{" "}
          <span class="faint">or in your AWS.</span>
        </h2>
        <p class="section-note mono">
          Early, open, Apache 2.0. Read the source before you trust it with your repos.
        </p>
        <div class="fact-row">
          <span class="fact-chip">apache-2.0</span>
          <span class="fact-chip">go control plane</span>
          <span class="fact-chip">typescript sdk</span>
          <span class="fact-chip">firecracker microVMs</span>
          <span class="fact-chip">opentofu modules</span>
        </div>
      </div>
      <div class="homes-grid">
        <div class="home-card home-card-cloud panel">
          <p class="home-label">
            <svg class="home-icon" viewBox="0 0 10 10" aria-hidden="true">
              {cloudPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            Helmr Cloud <span class="chip chip-warm">coming soon</span>
          </p>
          <p class="home-text">
            A managed fleet. Projects, environments, immutable deployments &mdash;
            no infrastructure to run.
          </p>
          <a class="btn btn-light" href="/docs">Read the docs</a>
        </div>
        <div class="home-card home-card-dark panel">
          <p class="home-label">
            <svg class="home-icon" viewBox="0 0 10 10" aria-hidden="true">
              {shieldPixels.map((pixel) => (
                <rect x={pixel.x} y={pixel.y} width="1" height="1" />
              ))}
            </svg>
            Your AWS account
          </p>
          <p class="home-text">
            The identical control plane and workers in your VPC, Apache 2.0.
            Credentials never leave your boundary.
          </p>
          <a class="btn btn-dark" href="/docs/self-hosting/overview">Self-hosting guide</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    import { mountDitherScene } from "../lib/dither-scene";

    const printCanvas = document.querySelector<HTMLCanvasElement>("[data-print]");
    if (printCanvas) {
      mountDitherScene(printCanvas, {
        horizonPx: 124,
        skyMax: 0.34,
        sun: false,
        frost: 1,
        animate: false,
      });
    }

    const copyInstallButton = document.querySelector("[data-copy-install]");
    const installCommand = document.querySelector("[data-install-command]");

    copyInstallButton?.addEventListener("click", async () => {
      const text = installCommand?.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      copyInstallButton.setAttribute("data-copied", "true");
      window.setTimeout(() => {
        copyInstallButton.removeAttribute("data-copied");
      }, 1600);
    });
  </script>
</BaseLayout>

<style>
  .landing {
    position: relative;
    overflow-x: clip;
    --editorial-bg: #fff;
    --editorial-rule: #dedede;
    background: var(--editorial-bg);
  }

  :global(body:has(.landing)),
  :global(body:has(.landing) .site-header),
  :global(body:has(.landing) .site-footer) {
    background: #fff;
  }

  :global(body:has(.landing)) {
