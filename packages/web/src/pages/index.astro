const codePick = { usecase: "review", agent: "claude", interface: "slack" } as const;

const codeSegment = (
  key: string,
  pick: { agent: string; interface: string; usecase: string },
): string[] => {
  if (key === "blank") return ["&nbsp;"];
  const [scope, name] = key.split(".") as [string, string];
  if (scope === "agent") {
    const agent = codeParts.agents[pick.agent] as { imports: string[]; body: string[]; meta: string };
    return agent[name as "imports" | "body"];
  }
  if (scope === "usecase") {
    const usecase = codeParts.usecases[pick.usecase] as {
      file: string;
      primitive: string;
      imports: string[];
      head: string[];
      meta: string[];
      action: string[];
    };
    return usecase[name as "imports" | "head" | "meta" | "action"];
  }
  if (scope === "interface") {
    return codeParts.interfaces[pick.interface]!.lines;
  }
  return codeParts.fixed[name] as string[];
};

const initialCodeLines = codeRecipe.flatMap(([key, region]) =>
