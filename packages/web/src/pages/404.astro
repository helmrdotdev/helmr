---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Helmr" path="/404" noindex minimalHeader>
  <section class="not-found">
    <img class="lost" src="/characters/hiker.svg" alt="" width="128" height="128" />
    <h1 class="headline">404 — off the chart.</h1>
    <p>This page drifted away. Head back to known waters.</p>
    <div class="not-found-actions">
      <a class="btn btn-dark" href="/">Home</a>
      <a class="btn btn-light" href="/docs">Docs</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .lost {
    width: 8rem;
    height: auto;
    margin-bottom: 0.5rem;
  }

  .not-found h1 {
    font-size: 2rem;
    line-height: 1.1;
  }

  .not-found p {
    color: var(--text-muted);
  }

  .not-found-actions {
    display: flex;
    gap: 0.75rem;
  }
</style>
