---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocs } from "../../lib/docs";

const docs = await getDocs();

const entryPoints = [
  {
    section: "Quickstart",
    title: "Run your first agent",
    description: "Install Helmr, deploy a TypeScript project, and complete a Turn on a durable Computer.",
    href: "/docs/quickstart",
    character: "hiker",
    tone: "yellow",
    links: [
      { label: "Quickstart", href: "/docs/quickstart" },
      { label: "Build a durable agent", href: "/docs/guides/build-a-durable-agent" },
    ],
  },
  {
    section: "Concepts",
    title: "Understand the runtime",
    description: "See how Agents, Computers, Sessions and Turns fit together, and what Helmr keeps durable.",
    href: "/docs/concepts/how-helmr-works",
    character: "owl",
    tone: "green",
    links: [
      { label: "Agents", href: "/docs/concepts/agents" },
      { label: "Durability", href: "/docs/concepts/durability" },
    ],
  },
  {
    section: "Guides",
    title: "Do one thing",
    description: "Deploy, prepare a Computer, observe a Session, answer questions or connect Slack.",
    href: "/docs/guides/start-and-observe-a-session",
    character: "ant",
    tone: "blue",
    links: [
      { label: "Prepare a computer", href: "/docs/guides/prepare-a-computer" },
      { label: "Connect Slack", href: "/docs/guides/connect-slack" },
    ],
  },
  {
    section: "Reference",
    title: "Look up an interface",
    description: "Check the SDK, CLI, REST API, configuration, environment variables and Session events.",
    href: "/docs/reference/sdk/overview",
    character: "robot",
    tone: "pink",
    links: [
      { label: "CLI", href: "/docs/reference/cli/overview" },
      { label: "REST API", href: "/docs/reference/api/overview" },
    ],
  },
  {
    section: "Self-hosting",
    title: "Run Helmr in AWS",
    description: "Choose the evaluation or production stack, then operate the control plane and workers.",
    href: "/docs/self-hosting/overview",
    character: "hut",
    tone: "blue",
    links: [
      { label: "Evaluation", href: "/docs/self-hosting/evaluation" },
      { label: "Production", href: "/docs/self-hosting/production" },
    ],
  },
];
---

<DocsLayout title="Helmr Docs" description="Documentation for installing, operating, and extending Helmr." docs={docs}>
  <h1>Docs</h1>
  <p>
    Learn the runtime, build with its public interfaces, and operate Helmr in your AWS account.
  </p>
  <div class="docs-index-grid">
    {entryPoints.map((entry) => (
      <section>
        <a class="entry-main" href={entry.href} data-astro-prefetch="viewport">
          <span class="entry-head">
            <span class="entry-icon" aria-hidden="true" style={`background: var(--wash-${entry.tone})`}>
              <img src={`/characters/${entry.character}.svg`} alt="" width="22" height="22" />
            </span>
            <span class="entry-section">{entry.section}</span>
          </span>
          <strong>{entry.title}</strong>
          <p>{entry.description}</p>
        </a>
        <div class="entry-links" aria-label={`${entry.section} links`}>
          {entry.links.map((link) => (
            <a href={link.href} data-astro-prefetch="viewport">{link.label}</a>
          ))}
        </div>
      </section>
    ))}
  </div>
</DocsLayout>

<style>
  .docs-index-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.4rem;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .docs-index-grid section {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .docs-index-grid section:first-child {
    grid-column: 1 / -1;
  }

  .entry-main {
    display: block;
    min-height: 8rem;
    color: var(--text);
    padding: 0.85rem;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out;
  }

  .entry-main:hover {
    background: var(--surface-dim);
  }

  .entry-main:hover strong {
    color: var(--accent);
  }

  .entry-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.65rem;
  }

  .entry-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
  }

  .entry-icon img { width: 22px; height: 22px; }

  .entry-section {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .entry-main strong {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .entry-main p {
    margin-top: 0.55rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .entry-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .entry-links a {
    min-height: 2.45rem;
    color: var(--text-muted);
    padding: 0.7rem 0.85rem;
    font-size: 0.74rem;
    line-height: 1.2;
    text-decoration: none;
  }

  .entry-links a + a {
    border-left: 1px solid var(--border);
  }

  .entry-links a:hover {
    background: var(--accent-wash);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .docs-index-grid {
      grid-template-columns: 1fr;
    }

    .docs-index-grid section:first-child {
      grid-column: auto;
    }

    .entry-links {
      grid-template-columns: 1fr;
    }

    .entry-links a + a {
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }
</style>
